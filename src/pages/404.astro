---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found">
    <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-6 py-20">
        <div class="w-24 h-24 bg-brand-gold/20 text-brand-gold rounded-full flex items-center justify-center mb-8">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        
        <h1 class="text-6xl font-extrabold text-brand-dark mb-4 tracking-tighter">404</h1>
        <h2 class="text-2xl font-bold text-slate-800 mb-6">Page Not Found</h2>
        <p class="text-slate-600 text-lg mb-10 max-w-md mx-auto font-light leading-relaxed">
            Oops! The page you are looking for has either been moved, deleted, or does not exist.
        </p>
        
        <a href="/" class="bg-brand-dark text-white font-bold px-8 py-4 rounded-xl hover:bg-slate-800 transition shadow-lg inline-flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Return Home
        </a>
    </div>
</Layout>