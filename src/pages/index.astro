---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
	<section class="relative bg-brand-dark text-brand-light overflow-hidden">
		<div class="relative max-w-7xl mx-auto px-6 sm:px-8 lg:px-10 py-28 lg:py-36 flex flex-col items-center text-center">
			<h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter mb-8 max-w-4xl leading-tight">
				IMT: Where <span class="text-brand-gold">Theory</span> and <span class="text-brand-gold">Application</span> Converge
			</h1>
			<p class="text-xl md:text-2xl text-gray-300 max-w-3xl mb-12 leading-relaxed font-light">
				Welcome to the <span class="text-brand-gold">Integrated Mathematics Tournament</span>, an annual online competition introducing students to the vast landscape of applied mathematics.
			</p>
            
            <div class="flex flex-col sm:flex-row flex-wrap justify-center gap-4 sm:gap-6 w-full max-w-4xl">
				<a href="/format" class="bg-transparent border-2 border-brand-gold text-brand-gold font-bold py-4 px-8 rounded-full hover:bg-brand-gold hover:text-brand-dark transition duration-200 text-lg text-center">
					Learn More
				</a>
                <a href="/register" class="bg-brand-gold text-brand-dark font-bold py-4 px-8 rounded-full shadow-lg hover:opacity-90 hover:scale-105 transition transform duration-200 text-lg text-center">
					Register Now!
				</a>
				<a href="/team" class="bg-transparent border-2 border-brand-gold text-brand-gold font-bold py-4 px-8 rounded-full hover:bg-brand-gold hover:text-brand-dark transition duration-200 text-lg text-center">
					Meet the Team
				</a>
			</div>
		</div>
	</section>

	<section class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10">
			<div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-start">
				
				<div class="lg:w-1/3 border-l-4 border-brand-green pl-8">
					<h2 class="text-4xl md:text-5xl font-extrabold text-brand-dark leading-tight tracking-tight">
						Mathematics <br/>
						<span class="text-brand-green">Reimagined</span>
					</h2>
					<div class="mt-6 w-16 h-1.5 bg-brand-gold rounded-full"></div>
				</div>

				<div class="lg:w-2/3">
					<p class="text-2xl md:text-3xl text-gray-800 font-light leading-relaxed mb-8">
						The Integrated Mathematics Tournament <span class="font-semibold text-brand-dark">bridges the gap</span> between rigorous competition math and real-world analytical application.
					</p>
					
					<div class="grid md:grid-cols-2 gap-8 text-lg text-gray-600 font-light leading-relaxed">
						<p>
							We challenge students to move beyond computational mathematics, immersing them in <span class="text-brand-green font-medium">mathematical applications</span>. 
						</p>
						<p>
							We integrate creative problem-solving with open-ended data analysis and applications.
						</p>
					</div>
				</div>

			</div>
		</div>
	</section>
</Layout>