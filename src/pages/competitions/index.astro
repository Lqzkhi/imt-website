---
import Layout from '../../layouts/Layout.astro';

const fallRegistrationUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSdp3uVAAHhcEO5q9WzS2fkNh0fypudgwIUSuC_87fjJBcKVug/viewform?usp=publish-editor';
---

<Layout
  title="Competitions"
  description="Dates, formats, registration, results, and archives for the Integrated Mathematics Tournament."
>
  <header class="competition-header">
    <div class="site-container header-grid">
      <div>
        <p class="eyebrow">Competitions</p>
        <h1 class="page-title">Integrated Mathematics Tournament</h1>
      </div>
      <p class="lede">Free online tournaments with short answers, written proofs, and applied team problems.</p>
    </div>
  </header>

  <section class="section-compact format-section">
    <div class="site-container format-grid">
      <div>
        <p class="eyebrow">Format</p>
        <h2 class="section-title">How the tournament works</h2>
      </div>
      <div class="format-points">
        <article>
          <h3>Problem solving and proof</h3>
          <p>Students submit short answers and full written proofs. Both the answer and the reasoning are graded.</p>
        </article>
        <article>
          <h3>The Integrated Round</h3>
          <p>Teams use advanced mathematics for modeling and data problems.</p>
        </article>
        <article>
          <h3>Open access</h3>
          <p>Entry, problems, solutions, and learning materials are free.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section tournament-section" id="tournaments">
    <div class="site-container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Schedule and archive</p>
          <h2 class="section-title">Tournaments</h2>
        </div>
      </div>

      <div class="tournament-list">
        <article class="tournament-row current">
          <div>
            <span class="status">Registration open</span>
            <h3>Fall 2026</h3>
            <p>Online qualifier and live final</p>
          </div>
          <dl>
            <div><dt>Round 1</dt><dd>Sep 26 to Oct 10</dd></div>
            <div><dt>Final</dt><dd>Oct 17</dd></div>
            <div><dt>Cost</dt><dd>Free</dd></div>
          </dl>
          <div class="row-actions">
            <a class="button-primary" href={fallRegistrationUrl} target="_blank" rel="noopener noreferrer">Register</a>
            <a class="text-link" href="/competitions/fall-2026">View details</a>
          </div>
        </article>

        <article class="tournament-row">
          <div>
            <span class="status past">Concluded</span>
            <h3>Spring 2026</h3>
            <p>Inaugural tournament</p>
          </div>
          <dl>
            <div><dt>Competitors</dt><dd>200+</dd></div>
            <div><dt>Countries</dt><dd>35+</dd></div>
            <div><dt>Events</dt><dd>6</dd></div>
          </dl>
          <div class="row-actions">
            <a class="button-secondary" href="/competitions/spring-2026">Results and archive</a>
          </div>
        </article>
      </div>
    </div>
  </section>
</Layout>

<style>
  .competition-header {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .header-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.7fr);
    gap: 4rem;
    align-items: end;
    padding-block: clamp(3.75rem, 7vw, 6rem);
  }

  .header-grid .lede { margin: 0 0 0.25rem; }
  .format-section { border-bottom: 1px solid var(--line); background: white; }
  .format-grid { display: grid; grid-template-columns: 0.8fr 1.7fr; gap: 4rem; }
  .format-points { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
  .format-points article { border-right: 1px solid var(--line); padding: 1.25rem 1.4rem 0 0; }
  .format-points article + article { padding-left: 1.4rem; }
  .format-points article:last-child { border-right: 0; }
  .format-points h3 { margin: 0 0 0.65rem; font-size: 0.95rem; }
  .format-points p { margin: 0; color: var(--muted); font-size: 0.86rem; line-height: 1.6; }

  .tournament-section { background: var(--paper); }
  .section-heading { margin-bottom: 2rem; }
  .tournament-list { border-top: 1px solid var(--line); }
  .tournament-row {
    display: grid;
    grid-template-columns: minmax(210px, 0.8fr) minmax(340px, 1.4fr) minmax(160px, 0.6fr);
    gap: 3rem;
    align-items: center;
    border-bottom: 1px solid var(--line);
    padding-block: 2rem;
  }
  .tournament-row.current { border-top: 3px solid var(--green); }
  .status { color: var(--green); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; }
  .status.past { color: var(--muted); }
  .tournament-row h3 { margin: 0.4rem 0 0.15rem; font-family: "Inter", Arial, sans-serif; font-size: 1.85rem; font-weight: 750; letter-spacing: -0.03em; }
  .tournament-row > div > p { margin: 0; color: var(--muted); font-size: 0.84rem; }
  .tournament-row dl { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0; }
  .tournament-row dl div { border-left: 1px solid var(--line); padding-left: 1rem; }
  .tournament-row dt { color: var(--muted); font-size: 0.7rem; text-transform: uppercase; }
  .tournament-row dd { margin: 0.35rem 0 0; font-size: 0.86rem; font-weight: 700; }
  .row-actions { display: flex; flex-direction: column; align-items: stretch; gap: 0.8rem; text-align: center; }

  @media (max-width: 900px) {
    .header-grid,
    .format-grid { grid-template-columns: 1fr; gap: 2rem; }
    .tournament-row { grid-template-columns: 1fr; gap: 1.5rem; }
    .row-actions { align-items: flex-start; }
  }

  @media (max-width: 620px) {
    .format-points { grid-template-columns: 1fr; }
    .format-points article,
    .format-points article + article { border-right: 0; border-bottom: 1px solid var(--line); padding: 1.2rem 0; }
    .tournament-row dl { grid-template-columns: 1fr; gap: 0.8rem; }
    .tournament-row dl div { border-left: 0; border-top: 1px solid var(--line); padding: 0.8rem 0 0; }
  }
</style>
