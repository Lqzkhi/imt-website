---
import Layout from '../../../../layouts/Layout.astro';
const { testId } = Astro.params;
---

<Layout title="Edit Test" description="Author and configure a secure Integrated Math test.">
  <section id="test-editor-root" data-test-id={testId} class="min-h-screen pb-16">
    <header class="bg-brand-dark text-white border-b-4 border-brand-gold">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10 py-8">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5">
          <div class="min-w-0">
            <a href="/test-portal/admin" class="text-xs font-bold text-slate-400 hover:text-brand-gold">← Admin workspace</a>
            <p class="text-[11px] font-bold uppercase tracking-[0.19em] text-brand-gold mt-5 mb-1">Test editor</p>
            <h1 id="editor-heading" class="font-serif font-bold text-3xl md:text-4xl truncate">Loading…</h1>
          </div>
          <div class="flex flex-wrap gap-2">
            <a id="preview-link" class="editor-header-action" href="#">Preview</a>
            <a id="submissions-link" class="editor-header-action" href="#">Submissions</a>
          </div>
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10 py-9">
      <div id="editor-loader" class="flex justify-center items-center gap-3 py-24 text-slate-500">
        <span class="w-6 h-6 rounded-full border-2 border-slate-300 border-t-brand-green animate-spin"></span>
        <span class="font-semibold">Loading editor…</span>
      </div>
      <div id="editor-alert" class="hidden mb-6 rounded-lg border px-4 py-3 text-sm font-semibold" role="status"></div>

      <div id="editor-content" class="hidden space-y-9">
        <div id="structure-lock" class="hidden rounded-xl border border-amber-200 bg-amber-50 p-5 text-amber-900">
          <h2 class="font-bold">Problem structure is locked</h2>
          <p class="text-sm mt-1 leading-relaxed">This test has participant attempts, so its problems and answer keys are frozen for historical accuracy. Use “Duplicate” in the admin workspace to create an editable new version. Test settings may still be updated.</p>
        </div>

        <section class="rounded-xl border border-slate-200 bg-white shadow-sm p-5 md:p-6">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.17em] text-brand-green">Preflight</p>
              <h2 class="font-serif font-bold text-2xl text-brand-dark mt-1">Publish readiness</h2>
              <p class="text-xs text-slate-500 mt-2">The server repeats these checks before making a test visible.</p>
            </div>
            <span id="readiness-summary" class="rounded-full border px-3 py-1.5 text-xs font-bold"></span>
          </div>
          <div id="readiness-list" class="grid sm:grid-cols-2 lg:grid-cols-5 gap-3 mt-5"></div>
        </section>

        <section class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
          <div class="px-6 py-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.17em] text-brand-green">Configuration</p>
              <h2 class="font-serif font-bold text-2xl text-brand-dark mt-1">Test settings</h2>
            </div>
            <button id="save-settings" form="settings-form" type="submit" class="editor-primary">Save settings</button>
          </div>

          <form id="settings-form" class="p-6 md:p-8 grid lg:grid-cols-[1.1fr_.9fr] gap-8">
            <div class="space-y-5">
              <div>
                <label for="test-title" class="editor-label">Title</label>
                <input id="test-title" type="text" maxlength="160" required class="editor-input" />
              </div>
              <div>
                <label for="test-description" class="editor-label">Short description</label>
                <textarea id="test-description" rows="3" maxlength="5000" class="editor-input resize-y"></textarea>
              </div>
              <div>
                <div class="flex items-end justify-between gap-3 mb-2">
                  <label for="test-instructions" class="editor-label !mb-0">Instructions (LaTeX supported)</label>
                  <span class="text-[10px] text-slate-400">Use $...$ or $$...$$</span>
                </div>
                <textarea id="test-instructions" rows="8" maxlength="50000" class="editor-input font-mono text-sm resize-y" placeholder="Write participant instructions here…"></textarea>
              </div>
              <div>
                <span class="editor-label">Instructions preview</span>
                <div id="instructions-preview" class="portal-math min-h-[90px] rounded-lg border border-slate-200 bg-slate-50 p-5 whitespace-pre-wrap text-sm leading-relaxed text-brand-dark"></div>
              </div>
            </div>

            <div class="space-y-5">
              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label for="test-duration" class="editor-label">Duration (minutes)</label>
                  <input id="test-duration" type="number" min="1" max="43200" required class="editor-input" />
                </div>
                <div>
                  <label for="test-mode" class="editor-label">Security mode</label>
                  <select id="test-mode" class="editor-input">
                    <option value="one_sitting">One sitting</option>
                    <option value="take_home">Take-home / resumable</option>
                  </select>
                </div>
              </div>
              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label for="test-opens" class="editor-label">Opens (optional)</label>
                  <input id="test-opens" type="datetime-local" class="editor-input" />
                </div>
                <div>
                  <label for="test-closes" class="editor-label">Closes (optional)</label>
                  <input id="test-closes" type="datetime-local" class="editor-input" />
                </div>
              </div>
              <div>
                <label for="test-status" class="editor-label">Publishing status</label>
                <select id="test-status" class="editor-input">
                  <option value="draft">Draft (admin only)</option>
                  <option value="published">Published (visible to participants)</option>
                  <option value="archived">Archived (hidden from participants)</option>
                </select>
              </div>
              <div class="rounded-lg border border-slate-200 divide-y divide-slate-100">
                <label class="editor-check">
                  <input id="test-fullscreen" type="checkbox" class="accent-brand-green" />
                  <span><strong>Require fullscreen</strong><small>Prompt one-sitting participants to enter fullscreen and record exits.</small></span>
                </label>
                <label class="editor-check">
                  <input id="test-clipboard" type="checkbox" class="accent-brand-green" />
                  <span><strong>Block clipboard</strong><small>Prevent and record copy, cut, and paste actions.</small></span>
                </label>
                <label class="editor-check">
                  <input id="test-results" type="checkbox" class="accent-brand-green" />
                  <span><strong>Show scores after submission</strong><small>Shows points, but never exposes the answer key.</small></span>
                </label>
              </div>
              <div class="rounded-lg bg-slate-50 border border-slate-200 p-4 text-xs text-slate-500 leading-relaxed">
                One-sitting attempts are tab-bound and cannot pause. Take-home attempts may resume, but the personal duration and test closing time continue to run.
              </div>
            </div>
          </form>
        </section>

        <section>
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-5">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.17em] text-brand-green">Problem bank</p>
              <h2 class="font-serif font-bold text-3xl text-brand-dark mt-1">Problems and answer keys</h2>
              <p class="text-sm text-slate-500 mt-2">Problems are shown in this fixed order; question randomization is not used.</p>
            </div>
            <button id="add-question" type="button" class="editor-primary">Add problem</button>
          </div>
          <div id="question-list" class="space-y-4"></div>
          <div id="empty-questions" class="hidden rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center">
            <h3 class="font-bold text-brand-dark">No problems yet</h3>
            <p class="text-sm text-slate-500 mt-2">Add numerical, multiple-choice, or file-upload problems.</p>
          </div>
        </section>
      </div>
    </div>

    <div id="question-modal" class="hidden fixed inset-0 z-[100] bg-brand-dark/75 backdrop-blur-sm items-start justify-center overflow-y-auto p-4 md:p-8">
      <div class="bg-white w-full max-w-5xl rounded-xl shadow-2xl my-auto overflow-hidden">
        <div class="h-1 bg-brand-green"></div>
        <form id="question-form">
          <div class="px-6 md:px-8 py-5 border-b border-slate-100 flex items-center justify-between gap-4">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-wider text-brand-green">Problem editor</p>
              <h2 id="question-editor-heading" class="font-serif font-bold text-2xl text-brand-dark">Add problem</h2>
            </div>
            <button id="close-question" type="button" class="text-2xl text-slate-400 hover:text-brand-dark" aria-label="Close">×</button>
          </div>

          <div class="p-6 md:p-8 grid lg:grid-cols-2 gap-7 max-h-[75vh] overflow-y-auto">
            <div class="space-y-5">
              <input id="question-id" type="hidden" />
              <div class="grid grid-cols-[1fr_120px] gap-4">
                <div>
                  <label for="question-name" class="editor-label">Short title (optional)</label>
                  <input id="question-name" type="text" maxlength="160" class="editor-input" placeholder="Triangle area" />
                </div>
                <div>
                  <label for="question-points-input" class="editor-label">Points</label>
                  <input id="question-points-input" type="number" min="0" max="10000" step="0.01" value="1" required class="editor-input" />
                </div>
              </div>
              <div>
                <label for="question-prompt-input" class="editor-label">Problem statement (LaTeX supported)</label>
                <textarea id="question-prompt-input" rows="10" maxlength="50000" required class="editor-input font-mono text-sm resize-y" placeholder="If $x+3=7$, find $x$."></textarea>
              </div>
              <div>
                <label for="question-type" class="editor-label">Answer format</label>
                <select id="question-type" class="editor-input">
                  <option value="numerical">Numerical</option>
                  <option value="multiple_choice">Multiple choice</option>
                  <option value="file_upload">File upload</option>
                </select>
              </div>

              <div id="numerical-settings" class="grid sm:grid-cols-2 gap-4 rounded-lg border border-slate-200 bg-slate-50 p-4">
                <div>
                  <label for="numerical-answer" class="editor-label">Correct answer</label>
                  <input id="numerical-answer" type="number" step="any" class="editor-input" placeholder="4" />
                </div>
                <div>
                  <label for="numerical-tolerance" class="editor-label">Accepted tolerance</label>
                  <input id="numerical-tolerance" type="number" min="0" step="any" value="0" class="editor-input" />
                </div>
              </div>

              <div id="choice-settings" class="hidden rounded-lg border border-slate-200 bg-slate-50 p-4">
                <div class="flex items-center justify-between gap-3 mb-3">
                  <span class="editor-label !mb-0">Choices and correct answer</span>
                  <button id="add-choice" type="button" class="text-xs font-bold text-brand-green hover:underline">+ Add choice</button>
                </div>
                <div id="choice-list" class="space-y-2"></div>
                <p class="text-[11px] text-slate-400 mt-3">Select the radio button beside the correct choice. Choice text supports LaTeX.</p>
              </div>

              <div id="file-settings" class="hidden rounded-lg border border-slate-200 bg-slate-50 p-4 space-y-4">
                <div>
                  <span class="editor-label">Allowed file types</span>
                  <div class="flex flex-wrap gap-4 text-sm">
                    <label><input type="checkbox" name="file-extension" value="pdf" class="accent-brand-green" checked /> PDF</label>
                    <label><input type="checkbox" name="file-extension" value="png" class="accent-brand-green" checked /> PNG</label>
                    <label><input type="checkbox" name="file-extension" value="jpg" class="accent-brand-green" checked /> JPG/JPEG</label>
                    <label><input type="checkbox" name="file-extension" value="webp" class="accent-brand-green" /> WEBP</label>
                  </div>
                </div>
                <div>
                  <label for="file-size" class="editor-label">Maximum size (MB)</label>
                  <input id="file-size" type="number" min="1" max="25" value="10" class="editor-input max-w-32" />
                </div>
              </div>

              <div>
                <label for="grading-notes" class="editor-label">Private grading notes (optional)</label>
                <textarea id="grading-notes" rows="3" maxlength="20000" class="editor-input" placeholder="Visible only to administrators."></textarea>
              </div>
            </div>

            <div class="lg:sticky lg:top-0 lg:self-start">
              <span class="editor-label">Live problem preview</span>
              <div class="rounded-xl border border-slate-200 overflow-hidden">
                <div class="bg-brand-dark text-brand-gold text-xs font-bold px-4 py-3">Participant view</div>
                <div id="question-preview" class="portal-math min-h-[260px] p-6 whitespace-pre-wrap text-brand-dark leading-relaxed"></div>
              </div>
            </div>
          </div>

          <div class="px-6 md:px-8 py-5 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div id="question-error" class="hidden text-sm font-semibold text-red-600"></div>
            <div class="flex gap-3 sm:ml-auto">
              <button id="cancel-question" type="button" class="editor-secondary">Cancel</button>
              <button type="submit" class="editor-primary">Save problem</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .editor-header-action { border: 1px solid rgba(255,255,255,.18); border-radius: .45rem; color: white; padding: .65rem 1rem; font-size: .75rem; font-weight: 700; transition: border-color .15s, color .15s; }
  .editor-header-action:hover { border-color: #F5C518; color: #F5C518; }
  .editor-label { display: block; color: #162236; font-size: .68rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; margin-bottom: .5rem; }
  .editor-input { width: 100%; border: 1px solid rgb(203 213 225); border-radius: .5rem; padding: .7rem .85rem; outline: none; background: white; color: #162236; }
  .editor-input:focus { border-color: #4A7C59; box-shadow: 0 0 0 3px rgba(74,124,89,.12); }
  .editor-primary { display: inline-flex; align-items: center; justify-content: center; border-radius: .5rem; background: #162236; color: #F5C518; padding: .7rem 1.1rem; font-size: .78rem; font-weight: 800; transition: background .15s; }
  .editor-primary:hover { background: #1e3152; }
  .editor-primary:disabled { opacity: .45; cursor: not-allowed; }
  .editor-secondary { display: inline-flex; align-items: center; justify-content: center; border: 1px solid rgb(203 213 225); border-radius: .5rem; background: white; color: #162236; padding: .7rem 1.1rem; font-size: .78rem; font-weight: 700; }
  .editor-check { display: flex; align-items: flex-start; gap: .75rem; padding: 1rem; cursor: pointer; }
  .editor-check input { margin-top: .2rem; }
  .editor-check strong { display: block; color: #162236; font-size: .8rem; }
  .editor-check small { display: block; color: rgb(100 116 139); font-size: .7rem; line-height: 1.45; margin-top: .15rem; }
  .portal-math .katex-display { overflow-x: auto; overflow-y: hidden; padding: .4rem 0; }
</style>

<script>
  import { escapeHtml, getPortalSession, portalFetch, renderPortalMath } from '../../../../lib/testPortalClient';

  interface AnswerKey {
    numerical_answer: number | null;
    numerical_tolerance: number;
    choice_key: string | null;
    grading_notes: string;
  }
  interface EditorQuestion {
    id: string;
    position: number;
    title: string;
    prompt_latex: string;
    answer_type: 'numerical' | 'multiple_choice' | 'file_upload';
    options: { id: string; label: string }[];
    points: number;
    file_extensions: string[];
    max_file_size_mb: number;
    answer_key: AnswerKey;
  }
  interface EditorTest {
    id: string;
    title: string;
    description: string;
    instructions_latex: string;
    duration_minutes: number;
    security_mode: 'one_sitting' | 'take_home';
    require_fullscreen: boolean;
    block_clipboard: boolean;
    opens_at: string | null;
    closes_at: string | null;
    status: 'draft' | 'published' | 'archived';
    show_results: boolean;
  }

  const root = document.getElementById('test-editor-root')!;
  const testId = root.dataset.testId ?? '';
  const modal = document.getElementById('question-modal')!;
  let test: EditorTest;
  let questions: EditorQuestion[] = [];
  let attemptCount = 0;
  let choiceCounter = 0;
  let settingsDirty = false;
  let questionDirty = false;
  let questionSaving = false;

  function showAlert(message: string, kind: 'error' | 'success' = 'success') {
    const alert = document.getElementById('editor-alert')!;
    alert.textContent = message;
    alert.className = `mb-6 rounded-lg border px-4 py-3 text-sm font-semibold ${kind === 'success' ? 'border-green-200 bg-green-50 text-green-800' : 'border-red-200 bg-red-50 text-red-700'}`;
    alert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function toLocalInput(iso: string | null) {
    if (!iso) return '';
    const date = new Date(iso);
    return new Date(date.getTime() - date.getTimezoneOffset() * 60_000).toISOString().slice(0, 16);
  }

  function fromLocalInput(value: string) {
    return value ? new Date(value).toISOString() : null;
  }

  function rerenderMath(element: HTMLElement, content: string) {
    element.textContent = content;
    element.removeAttribute('data-math-rendered');
    renderPortalMath(element.parentElement ?? element);
  }

  function getReadiness() {
    const title = (document.getElementById('test-title') as HTMLInputElement).value.trim();
    const duration = Number((document.getElementById('test-duration') as HTMLInputElement).value);
    const opens = (document.getElementById('test-opens') as HTMLInputElement).value;
    const closes = (document.getElementById('test-closes') as HTMLInputElement).value;
    const answerKeysReady = questions.every((question) => {
      if (question.answer_type === 'file_upload') return true;
      if (question.answer_type === 'numerical') return question.answer_key?.numerical_answer !== null && question.answer_key?.numerical_answer !== undefined;
      return Boolean(question.answer_key?.choice_key && question.options.some((option) => option.id === question.answer_key.choice_key));
    });
    const checks = [
      { label: 'Title', detail: title ? 'Set' : 'Required', ready: Boolean(title) },
      { label: 'Duration', detail: Number.isInteger(duration) && duration >= 1 && duration <= 43_200 ? `${duration} minutes` : '1–43,200 required', ready: Number.isInteger(duration) && duration >= 1 && duration <= 43_200 },
      { label: 'Problems', detail: questions.length ? `${questions.length} added` : 'Add at least one', ready: questions.length > 0 },
      { label: 'Answer keys', detail: answerKeysReady ? 'Complete' : 'Missing or invalid', ready: answerKeysReady },
      { label: 'Availability', detail: !opens || !closes || new Date(closes) > new Date(opens) ? 'Valid' : 'Closing must be later', ready: !opens || !closes || new Date(closes) > new Date(opens) },
    ];
    return { checks, ready: checks.every((check) => check.ready) };
  }

  function renderReadiness() {
    const readiness = getReadiness();
    const summary = document.getElementById('readiness-summary')!;
    summary.textContent = readiness.ready ? 'Ready to publish' : 'Needs attention';
    summary.className = `rounded-full border px-3 py-1.5 text-xs font-bold ${readiness.ready ? 'border-green-200 bg-green-50 text-green-700' : 'border-amber-200 bg-amber-50 text-amber-700'}`;
    document.getElementById('readiness-list')!.innerHTML = readiness.checks.map((check) => `
      <div class="rounded-lg border p-3 ${check.ready ? 'border-green-100 bg-green-50/60' : 'border-amber-200 bg-amber-50'}">
        <span class="block text-[10px] font-bold uppercase tracking-wider ${check.ready ? 'text-green-700' : 'text-amber-700'}">${check.ready ? '✓' : '!'} ${escapeHtml(check.label)}</span>
        <strong class="block text-xs text-brand-dark mt-1">${escapeHtml(check.detail)}</strong>
      </div>
    `).join('');
  }

  function populateSettings() {
    document.getElementById('editor-heading')!.textContent = test.title;
    document.title = `Edit ${test.title} | Integrated Math`;
    (document.getElementById('test-title') as HTMLInputElement).value = test.title;
    (document.getElementById('test-description') as HTMLTextAreaElement).value = test.description;
    (document.getElementById('test-instructions') as HTMLTextAreaElement).value = test.instructions_latex;
    (document.getElementById('test-duration') as HTMLInputElement).value = String(test.duration_minutes);
    (document.getElementById('test-mode') as HTMLSelectElement).value = test.security_mode;
    (document.getElementById('test-opens') as HTMLInputElement).value = toLocalInput(test.opens_at);
    (document.getElementById('test-closes') as HTMLInputElement).value = toLocalInput(test.closes_at);
    (document.getElementById('test-status') as HTMLSelectElement).value = test.status;
    (document.getElementById('test-fullscreen') as HTMLInputElement).checked = test.require_fullscreen;
    (document.getElementById('test-clipboard') as HTMLInputElement).checked = test.block_clipboard;
    (document.getElementById('test-results') as HTMLInputElement).checked = test.show_results;
    rerenderMath(document.getElementById('instructions-preview')!, test.instructions_latex || 'Instructions preview will appear here.');
    (document.getElementById('preview-link') as HTMLAnchorElement).href = `/test-portal/admin/tests/${test.id}/preview`;
    (document.getElementById('submissions-link') as HTMLAnchorElement).href = `/test-portal/admin/tests/${test.id}/submissions`;
    document.getElementById('structure-lock')!.classList.toggle('hidden', attemptCount === 0);
    (document.getElementById('add-question') as HTMLButtonElement).disabled = attemptCount > 0;
    settingsDirty = false;
    renderReadiness();
  }

  function answerFormatLabel(type: EditorQuestion['answer_type']) {
    return type === 'numerical' ? 'Numerical · auto graded' : type === 'multiple_choice' ? 'Multiple choice · auto graded' : 'File upload · manual review';
  }

  function renderQuestionList() {
    const list = document.getElementById('question-list')!;
    const empty = document.getElementById('empty-questions')!;
    list.innerHTML = '';
    empty.classList.toggle('hidden', questions.length > 0);
    questions.forEach((question, index) => {
      const card = document.createElement('article');
      card.className = 'bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden';
      card.innerHTML = `
        <div class="p-5 md:p-6 flex flex-col lg:flex-row gap-5">
          <div class="w-10 h-10 shrink-0 rounded-lg bg-brand-dark text-brand-gold font-extrabold flex items-center justify-center">${index + 1}</div>
          <div class="min-w-0 flex-grow">
            <div class="flex flex-wrap items-center gap-3 mb-3">
              <h3 class="font-bold text-brand-dark">${escapeHtml(question.title || `Problem ${index + 1}`)}</h3>
              <span class="rounded-full bg-slate-50 border border-slate-200 px-2.5 py-1 text-[10px] font-bold text-slate-500">${escapeHtml(answerFormatLabel(question.answer_type))}</span>
              <span class="text-xs text-slate-400">${question.points} point${Number(question.points) === 1 ? '' : 's'}</span>
            </div>
            <div class="portal-math question-card-math text-sm text-slate-600 leading-relaxed whitespace-pre-wrap"></div>
          </div>
          <div class="flex lg:flex-col gap-2 shrink-0">
            <button class="editor-secondary edit-question" type="button" data-id="${question.id}" ${attemptCount ? 'disabled' : ''}>Edit</button>
            <div class="flex gap-1">
              <button class="editor-secondary move-question" type="button" data-id="${question.id}" data-direction="-1" aria-label="Move up" ${attemptCount || index === 0 ? 'disabled' : ''}>↑</button>
              <button class="editor-secondary move-question" type="button" data-id="${question.id}" data-direction="1" aria-label="Move down" ${attemptCount || index === questions.length - 1 ? 'disabled' : ''}>↓</button>
            </div>
            <button class="editor-secondary delete-question !text-red-600" type="button" data-id="${question.id}" ${attemptCount ? 'disabled' : ''}>Delete</button>
          </div>
        </div>
      `;
      const math = card.querySelector<HTMLElement>('.question-card-math')!;
      math.textContent = question.prompt_latex;
      list.appendChild(card);
    });
    renderPortalMath(list);
    renderReadiness();

    list.querySelectorAll<HTMLButtonElement>('.edit-question').forEach((button) => button.addEventListener('click', () => openQuestionEditor(button.dataset.id)));
    list.querySelectorAll<HTMLButtonElement>('.move-question').forEach((button) => button.addEventListener('click', () => void moveQuestion(button.dataset.id!, Number(button.dataset.direction))));
    list.querySelectorAll<HTMLButtonElement>('.delete-question').forEach((button) => button.addEventListener('click', () => void deleteQuestion(button.dataset.id!)));
  }

  function addChoiceRow(option: { id: string; label: string } = { id: '', label: '' }, correct = false) {
    choiceCounter += 1;
    const suggested = String.fromCharCode(64 + Math.min(choiceCounter, 26));
    const row = document.createElement('div');
    row.className = 'choice-row grid grid-cols-[24px_64px_1fr_32px] gap-2 items-center';
    row.innerHTML = `
      <input type="radio" name="correct-choice" aria-label="Correct choice" class="accent-brand-green" ${correct ? 'checked' : ''} />
      <input type="text" maxlength="80" value="${escapeHtml(option.id || suggested)}" aria-label="Choice identifier" class="editor-input !px-2 text-center font-bold choice-id" />
      <input type="text" maxlength="5000" value="${escapeHtml(option.label)}" aria-label="Choice text" class="editor-input choice-label" placeholder="Choice text" />
      <button type="button" class="remove-choice text-red-500 font-bold" aria-label="Remove choice">×</button>
    `;
    row.querySelector('.remove-choice')!.addEventListener('click', () => {
      row.remove();
      questionDirty = true;
    });
    document.getElementById('choice-list')!.appendChild(row);
  }

  function toggleQuestionType() {
    const type = (document.getElementById('question-type') as HTMLSelectElement).value;
    document.getElementById('numerical-settings')!.classList.toggle('hidden', type !== 'numerical');
    document.getElementById('choice-settings')!.classList.toggle('hidden', type !== 'multiple_choice');
    document.getElementById('file-settings')!.classList.toggle('hidden', type !== 'file_upload');
    if (type === 'multiple_choice' && !document.querySelector('.choice-row')) {
      addChoiceRow(); addChoiceRow(); addChoiceRow(); addChoiceRow();
    }
  }

  function openQuestionEditor(questionId?: string) {
    const question = questions.find((entry) => entry.id === questionId);
    (document.getElementById('question-id') as HTMLInputElement).value = question?.id ?? '';
    (document.getElementById('question-name') as HTMLInputElement).value = question?.title ?? '';
    (document.getElementById('question-points-input') as HTMLInputElement).value = String(question?.points ?? 1);
    (document.getElementById('question-prompt-input') as HTMLTextAreaElement).value = question?.prompt_latex ?? '';
    (document.getElementById('question-type') as HTMLSelectElement).value = question?.answer_type ?? 'numerical';
    (document.getElementById('numerical-answer') as HTMLInputElement).value = question?.answer_key?.numerical_answer === null || question?.answer_key?.numerical_answer === undefined ? '' : String(question.answer_key.numerical_answer);
    (document.getElementById('numerical-tolerance') as HTMLInputElement).value = String(question?.answer_key?.numerical_tolerance ?? 0);
    (document.getElementById('file-size') as HTMLInputElement).value = String(question?.max_file_size_mb ?? 10);
    (document.getElementById('grading-notes') as HTMLTextAreaElement).value = question?.answer_key?.grading_notes ?? '';
    document.getElementById('question-editor-heading')!.textContent = question ? `Edit problem ${question.position}` : 'Add problem';
    document.getElementById('question-error')!.classList.add('hidden');
    const list = document.getElementById('choice-list')!;
    list.innerHTML = '';
    choiceCounter = 0;
    (question?.options ?? []).forEach((option) => addChoiceRow(option, question?.answer_key?.choice_key === option.id));
    document.querySelectorAll<HTMLInputElement>('input[name="file-extension"]').forEach((input) => {
      const extensions = question?.file_extensions ?? ['pdf', 'png', 'jpg', 'jpeg'];
      input.checked = input.value === 'jpg' ? extensions.includes('jpg') || extensions.includes('jpeg') : extensions.includes(input.value);
    });
    toggleQuestionType();
    updateQuestionPreview();
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    questionDirty = false;
  }

  function closeQuestionEditor(force = false) {
    if (!force && questionDirty && !confirm('Discard the unsaved changes to this problem?')) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    questionDirty = false;
  }

  function updateQuestionPreview() {
    const prompt = (document.getElementById('question-prompt-input') as HTMLTextAreaElement).value || 'Problem preview will appear here.';
    rerenderMath(document.getElementById('question-preview')!, prompt);
  }

  function questionPayload() {
    const type = (document.getElementById('question-type') as HTMLSelectElement).value;
    const result: Record<string, unknown> = {
      title: (document.getElementById('question-name') as HTMLInputElement).value,
      prompt_latex: (document.getElementById('question-prompt-input') as HTMLTextAreaElement).value,
      points: Number((document.getElementById('question-points-input') as HTMLInputElement).value),
      answer_type: type,
      grading_notes: (document.getElementById('grading-notes') as HTMLTextAreaElement).value,
    };
    if (type === 'numerical') {
      result.numerical_answer = (document.getElementById('numerical-answer') as HTMLInputElement).value;
      result.numerical_tolerance = (document.getElementById('numerical-tolerance') as HTMLInputElement).value;
    } else if (type === 'multiple_choice') {
      const options: { id: string; label: string }[] = [];
      let choiceKey = '';
      document.querySelectorAll<HTMLElement>('.choice-row').forEach((row) => {
        const id = row.querySelector<HTMLInputElement>('.choice-id')!.value.trim();
        const label = row.querySelector<HTMLInputElement>('.choice-label')!.value.trim();
        options.push({ id, label });
        if (row.querySelector<HTMLInputElement>('input[type="radio"]')!.checked) choiceKey = id;
      });
      result.options = options;
      result.choice_key = choiceKey;
    } else {
      const extensions = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="file-extension"]:checked')).flatMap((input) => input.value === 'jpg' ? ['jpg', 'jpeg'] : [input.value]);
      result.file_extensions = extensions;
      result.max_file_size_mb = Number((document.getElementById('file-size') as HTMLInputElement).value);
    }
    return result;
  }

  async function moveQuestion(id: string, direction: number) {
    const index = questions.findIndex((question) => question.id === id);
    const swap = index + direction;
    if (index < 0 || swap < 0 || swap >= questions.length) return;
    [questions[index], questions[swap]] = [questions[swap], questions[index]];
    renderQuestionList();
    try {
      await portalFetch(`/api/test-portal/admin/tests/${testId}/reorder`, {
        method: 'POST',
        body: JSON.stringify({ question_ids: questions.map((question) => question.id) }),
      });
      questions.forEach((question, questionIndex) => question.position = questionIndex + 1);
    } catch (error) {
      showAlert(error instanceof Error ? error.message : 'The new order could not be saved.', 'error');
      await loadEditor();
    }
  }

  async function deleteQuestion(id: string) {
    if (!confirm('Delete this problem and its answer key? This cannot be undone.')) return;
    try {
      await portalFetch(`/api/test-portal/admin/questions/${id}`, { method: 'DELETE' });
      questions = questions.filter((question) => question.id !== id);
      questions.forEach((question, index) => question.position = index + 1);
      renderQuestionList();
      showAlert('Problem deleted.');
    } catch (error) {
      showAlert(error instanceof Error ? error.message : 'The problem could not be deleted.', 'error');
    }
  }

  async function loadEditor() {
    const session = await getPortalSession();
    if (!session) { location.href = '/test-portal'; return; }
    try {
      const data = await portalFetch<{ test: EditorTest; questions: EditorQuestion[]; attempt_count: number }>(`/api/test-portal/admin/tests/${testId}`);
      test = data.test;
      questions = data.questions.map((question) => ({ ...question, points: Number(question.points) }));
      attemptCount = data.attempt_count;
      populateSettings();
      renderQuestionList();
      document.getElementById('editor-loader')!.classList.add('hidden');
      document.getElementById('editor-content')!.classList.remove('hidden');
    } catch (error) {
      document.getElementById('editor-loader')!.classList.add('hidden');
      showAlert(error instanceof Error ? error.message : 'The editor could not be loaded.', 'error');
    }
  }

  document.getElementById('settings-form')!.addEventListener('submit', async (event) => {
    event.preventDefault();
    const requestedStatus = (document.getElementById('test-status') as HTMLSelectElement).value;
    if (requestedStatus === 'published' && !getReadiness().ready) {
      showAlert('Complete every publish-readiness check before publishing.', 'error');
      return;
    }
    const button = document.getElementById('save-settings') as HTMLButtonElement;
    button.disabled = true;
    button.textContent = 'Saving…';
    try {
      const result = await portalFetch<{ test: EditorTest }>(`/api/test-portal/admin/tests/${testId}`, {
        method: 'PATCH',
        body: JSON.stringify({
          title: (document.getElementById('test-title') as HTMLInputElement).value,
          description: (document.getElementById('test-description') as HTMLTextAreaElement).value,
          instructions_latex: (document.getElementById('test-instructions') as HTMLTextAreaElement).value,
          duration_minutes: Number((document.getElementById('test-duration') as HTMLInputElement).value),
          security_mode: (document.getElementById('test-mode') as HTMLSelectElement).value,
          opens_at: fromLocalInput((document.getElementById('test-opens') as HTMLInputElement).value),
          closes_at: fromLocalInput((document.getElementById('test-closes') as HTMLInputElement).value),
          status: (document.getElementById('test-status') as HTMLSelectElement).value,
          require_fullscreen: (document.getElementById('test-fullscreen') as HTMLInputElement).checked,
          block_clipboard: (document.getElementById('test-clipboard') as HTMLInputElement).checked,
          show_results: (document.getElementById('test-results') as HTMLInputElement).checked,
        }),
      });
      test = result.test;
      populateSettings();
      showAlert('Test settings saved.');
    } catch (error) {
      showAlert(error instanceof Error ? error.message : 'Settings could not be saved.', 'error');
    } finally {
      button.disabled = false;
      button.textContent = 'Save settings';
    }
  });

  const settingsForm = document.getElementById('settings-form') as HTMLFormElement;
  const markSettingsDirty = () => {
    settingsDirty = true;
    renderReadiness();
  };
  settingsForm.addEventListener('input', markSettingsDirty);
  settingsForm.addEventListener('change', markSettingsDirty);

  document.getElementById('test-instructions')!.addEventListener('input', () => rerenderMath(
    document.getElementById('instructions-preview')!,
    (document.getElementById('test-instructions') as HTMLTextAreaElement).value || 'Instructions preview will appear here.',
  ));
  document.getElementById('add-question')!.addEventListener('click', () => openQuestionEditor());
  document.getElementById('close-question')!.addEventListener('click', () => closeQuestionEditor());
  document.getElementById('cancel-question')!.addEventListener('click', () => closeQuestionEditor());
  document.getElementById('question-type')!.addEventListener('change', toggleQuestionType);
  document.getElementById('question-prompt-input')!.addEventListener('input', updateQuestionPreview);
  document.getElementById('add-choice')!.addEventListener('click', () => { addChoiceRow(); questionDirty = true; });
  modal.addEventListener('click', (event) => { if (event.target === modal) closeQuestionEditor(); });
  const questionForm = document.getElementById('question-form') as HTMLFormElement;
  const markQuestionDirty = () => { if (modal.classList.contains('flex')) questionDirty = true; };
  questionForm.addEventListener('input', markQuestionDirty);
  questionForm.addEventListener('change', markQuestionDirty);

  document.getElementById('question-form')!.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const inlineError = document.getElementById('question-error')!;
    button.disabled = true;
    questionSaving = true;
    inlineError.classList.add('hidden');
    const id = (document.getElementById('question-id') as HTMLInputElement).value;
    try {
      const result = await portalFetch<{ question: EditorQuestion }>(
        id ? `/api/test-portal/admin/questions/${id}` : `/api/test-portal/admin/tests/${testId}/questions`,
        { method: id ? 'PATCH' : 'POST', body: JSON.stringify(questionPayload()) },
      );
      const normalized = { ...result.question, points: Number(result.question.points) };
      if (id) questions = questions.map((question) => question.id === id ? normalized : question);
      else questions.push(normalized);
      renderQuestionList();
      questionDirty = false;
      closeQuestionEditor(true);
      showAlert(id ? 'Problem updated.' : 'Problem added.');
    } catch (error) {
      inlineError.textContent = error instanceof Error ? error.message : 'The problem could not be saved.';
      inlineError.classList.remove('hidden');
    } finally {
      button.disabled = false;
      questionSaving = false;
    }
  });

  window.addEventListener('beforeunload', (event) => {
    if (settingsDirty || questionDirty || questionSaving) {
      event.preventDefault();
    }
  });

  loadEditor();
</script>
