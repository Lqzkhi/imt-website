---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Diagnostic" description="Take an adaptive competition math diagnostic.">
  <section class="bg-brand-dark text-brand-light border-b-4 border-brand-green">
    <div class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-10 py-14 md:py-18">
      <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-10 items-start">
        <div>
          <span class="inline-block text-brand-green font-semibold tracking-widest uppercase text-xs mb-5">
            Learning Diagnostic
          </span>
          <h1 class="font-serif font-bold text-4xl md:text-5xl leading-tight mb-5">
            Find your competition math tier.
          </h1>
          <p class="text-slate-300 text-base md:text-lg font-light leading-relaxed max-w-2xl">
            A 15-25 question adaptive diagnostic across Algebra, Geometry, Number Theory, and Combinatorics.
          </p>
          <a href="/learn/diagnostic/how-it-works" class="inline-flex items-center gap-1.5 text-brand-green hover:text-white text-sm font-semibold transition-colors mt-4">
            How does this work?
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
          <div class="grid sm:grid-cols-3 gap-3 mt-8 max-w-2xl">
            <div class="border border-white/10 rounded p-4">
              <p class="text-2xl font-bold text-white">4</p>
              <p class="text-xs uppercase tracking-widest text-slate-400 mt-1">Domains</p>
            </div>
            <div class="border border-white/10 rounded p-4">
              <p class="text-2xl font-bold text-white">43</p>
              <p class="text-xs uppercase tracking-widest text-slate-400 mt-1">Skills</p>
            </div>
            <div class="border border-white/10 rounded p-4">
              <p class="text-2xl font-bold text-white">Beta</p>
              <p class="text-xs uppercase tracking-widest text-slate-400 mt-1">Report</p>
            </div>
          </div>
        </div>

        <form method="POST" action="/api/diagnostic/start" class="bg-white text-brand-dark border border-gray-200 rounded-lg p-6 md:p-7 shadow-xl shadow-black/10">
          <label class="block text-sm font-bold text-brand-dark mb-4">
            Highest contest experience
          </label>
          <div class="space-y-2 mb-6">
            {[
              { value: 'none', label: "I haven't taken one / not sure" },
              { value: 'amc8', label: 'AMC 8' },
              { value: 'amc10', label: 'AMC 10' },
              { value: 'amc12', label: 'AMC 12' },
              { value: 'aime', label: 'AIME' },
              { value: 'higher', label: 'USAMO / Olympiad or higher' },
            ].map((option) => (
              <label class="flex items-center gap-3 p-3 rounded border border-gray-200 hover:border-brand-green cursor-pointer text-sm transition-colors">
                <input
                  type="radio"
                  name="prior_level"
                  value={option.value}
                  checked={option.value === 'none'}
                  class="accent-brand-green"
                />
                <span>{option.label}</span>
              </label>
            ))}
          </div>

          <button type="submit" class="w-full bg-brand-dark text-brand-gold font-bold py-3 px-5 rounded hover:bg-[#1e3152] transition-colors duration-150 btn-lift">
            Begin Diagnostic
          </button>
          <p class="text-xs text-slate-400 leading-relaxed mt-4">
            No account required. Your result is stored in this browser.
          </p>
        </form>
      </div>
    </div>
  </section>
</Layout>
