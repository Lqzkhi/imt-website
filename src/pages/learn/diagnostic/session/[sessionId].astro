---
import Layout from '../../../../layouts/Layout.astro';
import { getOwnedDiagnosticSession } from '../../../../lib/catEngine';
import { getUserProfileFromCookie } from '../../../../lib/guestSession';
import { createServerClient } from '../../../../lib/supabaseServer';

const { sessionId } = Astro.params;
const supabase = createServerClient();
const profile = await getUserProfileFromCookie(supabase, Astro.cookies);

if (!profile || !sessionId) {
  return Astro.redirect('/learn/diagnostic');
}

const session = await getOwnedDiagnosticSession(supabase, sessionId, profile.id);

if (!session) {
  return Astro.redirect('/learn/diagnostic');
}

if (session.completed_at) {
  return Astro.redirect(`/learn/diagnostic/report/${sessionId}`);
}

if (!session.current_item_id) {
  return Astro.redirect('/learn/diagnostic');
}

const { data: item } = await supabase
  .from('item_bank')
  .select('id, original_file_id, source, display_attribution, problem_text, item_format, options, diagram_url, domain')
  .eq('id', session.current_item_id)
  .single();

if (!item) {
  return Astro.redirect('/learn/diagnostic');
}

const { count: answeredCount } = await supabase
  .from('item_responses')
  .select('id', { count: 'exact', head: true })
  .eq('session_id', sessionId);

const questionNumber = (answeredCount ?? 0) + 1;
const options = item.options && typeof item.options === 'object'
  ? Object.entries(item.options as Record<string, string>).sort(([a], [b]) => a.localeCompare(b))
  : [];
---

<Layout title="Diagnostic In Progress" description="Adaptive competition math diagnostic in progress.">
  <section class="bg-brand-light min-h-screen py-10 md:py-12">
    <div class="max-w-3xl mx-auto px-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <div>
          <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Question {questionNumber}</p>
          <h1 class="font-serif font-bold text-2xl text-brand-dark mt-1">Diagnostic</h1>
        </div>
        <span class="inline-flex w-fit items-center rounded bg-brand-green/10 text-brand-green px-3 py-1 text-[11px] font-bold uppercase tracking-widest">
          {item.domain}
        </span>
      </div>

      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <div class="p-6 md:p-8 border-b border-gray-100">
          <div class="math-content text-brand-dark text-lg leading-relaxed">
            {item.problem_text}
          </div>

          {item.diagram_url && (
            <div class="mt-6 flex justify-center">
              <img src={item.diagram_url} alt="Problem diagram" class="max-w-full max-h-80" />
            </div>
          )}
        </div>

        <form method="POST" action="/api/diagnostic/respond" class="p-6 md:p-8 space-y-5">
          <input type="hidden" name="session_id" value={sessionId} />
          <input type="hidden" name="item_id" value={item.id} />

          {item.item_format === 'mcq_5' && options.length > 0 && (
            <div class="space-y-2">
              {options.map(([letter, text]) => (
                <label class="flex items-start gap-3 p-3 rounded border border-gray-200 hover:border-brand-green cursor-pointer transition-colors">
                  <input type="radio" name="response_value" value={letter} required class="accent-brand-green mt-1" />
                  <span class="text-sm md:text-base leading-relaxed">
                    <strong>{letter}.</strong> <span class="math-content">{text}</span>
                  </span>
                </label>
              ))}
            </div>
          )}

          {item.item_format !== 'mcq_5' && (
            <label class="block">
              <span class="block text-sm font-semibold text-brand-dark mb-2">Your answer</span>
              <input
                type="text"
                name="response_value"
                required
                autocomplete="off"
                placeholder={item.item_format === 'free_integer' ? 'Enter an integer' : 'Enter your answer'}
                class="w-full border border-gray-300 rounded px-4 py-3 text-lg focus:outline-none focus:border-brand-green"
              />
            </label>
          )}

          <button type="submit" class="w-full bg-brand-dark text-brand-gold font-bold py-3 rounded hover:bg-[#1e3152] transition-colors duration-150 btn-lift">
            Submit Answer
          </button>
        </form>

        <details class="px-6 md:px-8 pb-6 -mt-2 text-xs text-slate-400">
          <summary class="cursor-pointer font-semibold text-slate-500 hover:text-brand-green">
            Source
          </summary>
          <div class="mt-3 rounded border border-gray-200 bg-slate-50 p-3 leading-relaxed">
            <p>{item.display_attribution || 'Integrated Math diagnostic item'}</p>
            <p class="mt-1">
              {item.source || 'Original Item'}{item.original_file_id ? ` · ${item.original_file_id}` : ''}
            </p>
          </div>
        </details>
      </div>

      <p class="text-center text-xs text-slate-400 mt-5">
        Difficulty adapts after each response. Results appear at the end.
      </p>
    </div>
  </section>

  <script>
    import renderMathInElement from 'katex/contrib/auto-render';

    document.addEventListener('DOMContentLoaded', () => {
      renderMathInElement(document.body, {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '$', right: '$', display: false },
        ],
      });
    });
  </script>
</Layout>
