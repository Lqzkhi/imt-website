---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Learning Hub" description="Free competition-math diagnostics, problems, solutions, and handouts from Integrated Math.">
  <header class="learn-header">
    <div class="site-container learn-header-grid">
      <div>
        <p class="eyebrow">Learning hub</p>
        <h1 class="page-title">Competition math resources</h1>
      </div>
      <p class="lede">Free handouts, past problems, and a skill diagnostic.</p>
    </div>
  </header>

  <section class="section diagnostic-section">
    <div class="site-container diagnostic-grid">
      <div>
        <p class="eyebrow">Start here</p>
        <h2 class="section-title">Skill diagnostic</h2>
        <p class="lede">A 15 to 25 question adaptive test in algebra, geometry, number theory, and combinatorics. Get a subject breakdown and a map of what to study next.</p>
        <div class="diagnostic-actions">
          <a class="button-primary" href="/learn/diagnostic">Start the diagnostic</a>
          <a class="text-link" href="/learn/diagnostic/how-it-works">How it works</a>
        </div>
      </div>

      <dl>
        <div><dt>4</dt><dd>subjects</dd></div>
        <div><dt>43</dt><dd>skills mapped</dd></div>
        <div><dt>15–25</dt><dd>questions</dd></div>
        <div><dt>~45 min</dt><dd>typical time</dd></div>
      </dl>
    </div>
  </section>

  <section class="section-compact archive-section">
    <div class="site-container archive-grid">
      <div>
        <p class="eyebrow">Problem archive</p>
        <h2 class="section-title">Spring 2026</h2>
        <p>All six inaugural IMT events, with full solutions. More than 50 original problems in four subjects.</p>
      </div>
      <div class="archive-links">
        <a class="button-secondary" href="/competitions/spring-2026">Browse problems and solutions</a>
        <span>Free to download</span>
      </div>
    </div>
  </section>

  <section class="section upcoming-section">
    <div class="site-container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">In development</p>
          <h2 class="section-title">More resources.</h2>
        </div>
        <a class="text-link" href="/register">Get updates</a>
      </div>

      <div class="rule-grid upcoming-grid">
        <article>
          <p class="date">Summer 2026</p>
          <h3>Handouts and modules</h3>
          <p>Graph theory, generating functions, projective geometry, and other Olympiad topics.</p>
        </article>
        <article>
          <p class="date">Fall 2026</p>
          <h3>Club curriculum</h3>
          <p>A semester plan with weekly problems, logistics, handout suggestions, and sample lessons.</p>
        </article>
      </div>
    </div>
  </section>
</Layout>

<style>
  .learn-header { border-bottom: 1px solid var(--line); background: var(--paper); }
  .learn-header-grid { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: 4rem; align-items: end; padding-block: clamp(3.75rem, 7vw, 6rem); }
  .learn-header-grid .lede { margin: 0; }
  .diagnostic-section { background: white; }
  .diagnostic-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: clamp(3rem, 9vw, 8rem); align-items: center; }
  .diagnostic-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem; margin-top: 2rem; }
  .diagnostic-grid dl { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .diagnostic-grid dl div { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 1.35rem; }
  .diagnostic-grid dt { font-family: "Inter", Arial, sans-serif; font-size: 2rem; font-weight: 750; letter-spacing: -0.04em; }
  .diagnostic-grid dd { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.75rem; }
  .archive-section { border-block: 1px solid var(--line); background: var(--paper); }
  .archive-grid { display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: center; }
  .archive-grid > div > p:not(.eyebrow) { max-width: 650px; color: var(--muted); line-height: 1.6; }
  .archive-links { display: flex; flex-direction: column; align-items: center; gap: 0.7rem; }
  .archive-links span { color: var(--muted); font-size: 0.72rem; }
  .upcoming-section { background: white; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .upcoming-grid { grid-template-columns: repeat(2, 1fr); }
  .upcoming-grid article { padding: 1.6rem; }
  .upcoming-grid .date { color: var(--green); font-size: 0.7rem; font-weight: 800; text-transform: uppercase; }
  .upcoming-grid h3 { margin: 2.5rem 0 0.6rem; font-family: "Inter", Arial, sans-serif; font-size: 1.25rem; }
  .upcoming-grid article > p:last-child { max-width: 480px; margin-bottom: 0; color: var(--muted); font-size: 0.88rem; line-height: 1.6; }
  @media (max-width: 760px) {
    .learn-header-grid,
    .diagnostic-grid,
    .archive-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .archive-links { align-items: flex-start; }
    .upcoming-grid { grid-template-columns: 1fr; }
    .section-heading { align-items: flex-start; flex-direction: column; }
  }
</style>
