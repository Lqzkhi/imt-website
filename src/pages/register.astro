---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portal Access">
    <div class="min-h-screen bg-brand-light flex items-center justify-center py-20 px-6">
        <div class="bg-white max-w-2xl w-full p-10 md:p-12 rounded-3xl shadow-xl border border-slate-100">
            
            <div class="text-center mb-8 border-b border-slate-100 pb-8">
                <h1 class="text-4xl font-extrabold text-brand-dark mb-3">Tournament Portal</h1>
                <p class="text-slate-600 font-light text-lg">Apply for IMT 2026 or log in to your approved team account.</p>
            </div>

            <div class="bg-brand-gold/10 border-l-4 border-brand-gold p-8 rounded-r-2xl mb-10">
                <h2 class="text-2xl font-bold text-brand-dark mb-4">Step 1: Apply to Compete</h2>
                <p class="text-slate-700 mb-6 leading-relaxed">New teams must fill out the official application. Once approved, your team's email will be whitelisted for portal access.</p>
                
                <a href="https://docs.google.com/forms/d/1dDcLWp5SkQWtZL3bHUetz5Mtp0Iwtgb0rdrgZrFUHHA/edit?ts=6a0bdf19" target="_blank" class="w-full bg-white border-2 border-brand-gold text-brand-dark font-extrabold text-lg py-3 px-8 rounded-xl hover:bg-brand-gold transition shadow-sm flex items-center justify-center gap-2">
                    Open Application Form
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
            </div>

            <div class="bg-slate-50 border border-slate-100 p-8 rounded-2xl">
                <h2 class="text-2xl font-bold text-brand-dark mb-4">Step 2: Access Portal</h2>
                <p class="text-slate-600 mb-6">Already approved? Enter your team's registered email to receive a secure login link. No password required.</p>

                <form id="magic-form" class="space-y-4">
                    <div>
                        <input type="email" id="email" required class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-green outline-none" placeholder="team-contact@example.com">
                    </div>
                    
                    <button type="submit" id="submit-btn" class="w-full bg-brand-dark text-brand-gold font-bold py-3 rounded-xl hover:bg-slate-800 transition shadow-md">
                        Send Login Link
                    </button>
                </form>

                <div id="status-message" class="hidden mt-4 p-4 rounded-lg font-bold text-sm text-center"></div>
            </div>

        </div>
    </div>
</Layout>

<script>
    import { supabase } from '../lib/supabase.js';

    const form = document.getElementById('magic-form');
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const submitBtn = document.getElementById('submit-btn');
    const statusMsg = document.getElementById('status-message');

    if(form) {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            submitBtn.textContent = "Sending...";
            submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
            statusMsg.classList.add('hidden');
            statusMsg.classList.remove('bg-red-50', 'text-red-500', 'bg-green-50', 'text-brand-green');

            const { error } = await supabase.auth.signInWithOtp({
                email: emailInput.value,
                options: {
                    emailRedirectTo: window.location.origin + '/portal' 
                }
            });

            submitBtn.textContent = "Send Login Link";
            submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            statusMsg.classList.remove('hidden');

            if (error) {
                // Intercept Supabase's generic database error caused by our whitelist trigger
                if (error.message.includes("Database error") || error.message.includes("Email not authorized")) {
                    statusMsg.textContent = "This email is not approved yet. Please wait for your application to be processed!";
                } else {
                    statusMsg.textContent = "Error: " + error.message;
                }
                statusMsg.classList.add('bg-red-50', 'text-red-500');
            } else {
                statusMsg.textContent = "Success! Check your email inbox for the secure link.";
                statusMsg.classList.add('bg-green-50', 'text-brand-green');
                form.reset();
            }
        });
    }
</script>