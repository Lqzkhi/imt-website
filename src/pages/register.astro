---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Email Updates" description="Get Integrated Math competition dates, results, and new learning resources by email.">
  <section class="signup-section">
    <div class="site-container signup-grid">
      <div>
        <p class="eyebrow">Email updates</p>
        <h1 class="page-title">Stay in the loop.</h1>
        <p class="lede">Register your email for competition dates, results, and new resources.</p>
        <ul>
          <li>Fall 2026 reminders</li>
          <li>Results and archives</li>
          <li>New handouts and resources</li>
        </ul>
      </div>

      <form id="registration-form" action="https://formspree.io/f/xojzalge" method="POST">
        <input type="hidden" name="subject" value="New Waitlist Registration" />
        <label for="email">Email address</label>
        <input class="form-control" type="email" id="email" name="email" required autocomplete="email" placeholder="student@example.com" />
        <div id="status-message" class="form-status" hidden></div>
        <button class="button-primary" type="submit" id="submit-btn">Get updates</button>
        <small>Unsubscribe at any time by contacting us.</small>
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('registration-form') as HTMLFormElement;
  const button = document.getElementById('submit-btn') as HTMLButtonElement;
  const status = document.getElementById('status-message') as HTMLElement;

  form?.addEventListener('submit', async event => {
    event.preventDefault();
    button.textContent = 'Submitting...';
    button.disabled = true;
    status.hidden = true;

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error();
      form.reset();
      status.textContent = "You're on the list.";
      status.className = 'form-status success';
    } catch {
      status.textContent = 'Something went wrong. Please try again.';
      status.className = 'form-status error';
    }

    status.hidden = false;
    button.textContent = 'Get updates';
    button.disabled = false;
  });
</script>

<style>
  .signup-section { min-height: 70vh; border-bottom: 1px solid var(--line); background: var(--paper); }
  .signup-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 0.65fr); gap: clamp(3rem, 10vw, 8rem); align-items: center; padding-block: clamp(5rem, 11vw, 9rem); }
  .signup-grid ul { display: grid; gap: 0.6rem; margin: 2rem 0 0; padding: 0; list-style: none; color: var(--muted); font-size: 0.9rem; }
  .signup-grid li::before { content: "•"; margin-right: 0.7rem; color: var(--green); }
  .signup-grid form { border-top: 3px solid var(--green); padding-top: 1.4rem; }
  .signup-grid label { display: block; margin-bottom: 0.6rem; font-size: 0.75rem; font-weight: 750; text-transform: uppercase; }
  .signup-grid button { width: 100%; margin-top: 0.8rem; }
  .signup-grid small { display: block; margin-top: 0.8rem; color: var(--muted); font-size: 0.72rem; }
  .form-status { margin-top: 0.8rem; padding: 0.75rem; border: 1px solid var(--line); font-size: 0.84rem; }
  .form-status.success { border-color: #9ec9b8; background: #edf7f2; color: var(--green); }
  .form-status.error { border-color: #d7aaa5; background: #fff1ef; color: #8b2c23; }
  @media (max-width: 760px) { .signup-grid { grid-template-columns: 1fr; } }
</style>
