---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Register for IMT">
    <div class="min-h-screen bg-brand-light flex items-center justify-center py-20 px-6">
        <div class="bg-white max-w-2xl w-full p-10 md:p-12 rounded-3xl shadow-xl border border-slate-100">
            
            <div class="text-center mb-8 border-b border-slate-100 pb-8">
                <h1 class="text-4xl font-extrabold text-brand-dark mb-3">Register Your Team</h1>
                <p class="text-slate-600 font-light text-lg">Apply for the 2026 Integrated Mathematics Tournament.</p>
            </div>

            <div class="bg-brand-gold/10 border-l-4 border-brand-gold p-8 rounded-r-2xl mb-10">
                <h2 class="text-2xl font-bold text-brand-dark mb-4">Tournament Application</h2>
                <p class="text-slate-700 mb-8 leading-relaxed text-lg">To compete in the upcoming tournament, please fill out the official application below. Once your team is approved, we will follow up with further details!</p>
                
                <div class="text-center flex justify-center">
                    <a href="https://docs.google.com/forms/d/1dDcLWp5SkQWtZL3bHUetz5Mtp0Iwtgb0rdrgZrFUHHA/edit?ts=6a0bdf19" target="_blank" class="w-full bg-brand-dark text-brand-gold font-extrabold text-lg py-4 px-8 rounded-xl hover:bg-slate-800 transition transform hover:-translate-y-0.5 shadow-lg flex items-center justify-center gap-2">
                        Open Application Form
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</Layout>