---
import Layout from '../layouts/Layout.astro';

const teamMembers = [
  { name: 'Brandon Jia', role: 'Founder & Director', desc: 'Leads competitions, resources, problem creation, logistics, and web design. High school sophomore.' },
  { name: 'Christopher Liang', role: 'Founder & Director', desc: 'Leads problem creation and competition development. Incoming college freshman.' },
  { name: 'Jiwan Kim', role: 'Director & Logistics Lead', desc: 'Leads logistics and day-to-day competition operations. High school sophomore.' },
  { name: 'Yiran Yang', role: 'Outreach Lead', desc: 'Leads outreach and communications. Incoming college freshman.' },
];
---

<Layout title="Team & Contact" description="Meet the student team behind Integrated Math and contact us about competitions, resources, or sponsorship.">
  <header class="team-header">
    <div class="site-container team-header-grid">
      <div>
        <p class="eyebrow">About IMT</p>
        <h1 class="page-title">The people who built this.</h1>
      </div>
      <p class="lede">IMT is organized entirely by high school and college students, including USAMO and USAJMO qualifiers, AMC 12 perfect scorers, and AIME qualifiers. We built the competition we wanted to see.</p>
    </div>
  </header>

  <section class="section team-section">
    <div class="site-container">
      <p class="eyebrow">Leadership</p>
      <div class="team-list">
        {teamMembers.map(member => (
          <article>
            <div>
              <h2>{member.name}</h2>
              <p class="role">{member.role}</p>
            </div>
            <p>{member.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section contact-section">
    <div class="site-container contact-grid">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 class="section-title">Questions?</h2>
        <p class="lede">Ask about the tournament, registration, resources, or sponsorship. We usually reply within two days.</p>
      </div>

      <form id="contact-form" action="https://formspree.io/f/xojzalge" method="POST">
        <input type="hidden" name="subject" value="New IMT Contact Inquiry" />
        <label for="name">Name or organization</label>
        <input class="form-control" type="text" id="name" name="name" required autocomplete="name" />

        <label for="email">Email</label>
        <input class="form-control" type="email" id="email" name="email" required autocomplete="email" />

        <label for="message">Message</label>
        <textarea class="form-control" id="message" name="message" rows="5" required></textarea>

        <div id="contact-status" class="form-status" hidden></div>
        <button id="contact-submit-btn" class="button-primary" type="submit">Send message</button>
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const button = document.getElementById('contact-submit-btn') as HTMLButtonElement;
  const status = document.getElementById('contact-status') as HTMLElement;

  form?.addEventListener('submit', async event => {
    event.preventDefault();
    button.textContent = 'Sending...';
    button.disabled = true;
    status.hidden = true;

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error();
      form.reset();
      status.textContent = "Message sent. We'll be in touch soon.";
      status.className = 'form-status success';
    } catch {
      status.textContent = 'Something went wrong. Please try again.';
      status.className = 'form-status error';
    }

    status.hidden = false;
    button.textContent = 'Send message';
    button.disabled = false;
  });
</script>

<style>
  .team-header { border-bottom: 1px solid var(--line); background: var(--paper); }
  .team-header-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: end; padding-block: clamp(3.75rem, 7vw, 6rem); }
  .team-header-grid .lede { margin: 0; }
  .team-section { background: white; }
  .team-list { border-top: 1px solid var(--line); }
  .team-list article { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 3rem; border-bottom: 1px solid var(--line); padding-block: 1.6rem; }
  .team-list h2 { margin: 0; font-family: "Inter", Arial, sans-serif; font-size: 1.2rem; font-weight: 750; letter-spacing: -0.02em; }
  .team-list .role { margin: 0.3rem 0 0; color: var(--green); font-size: 0.72rem; font-weight: 750; text-transform: uppercase; }
  .team-list article > p { max-width: 600px; margin: 0; color: var(--muted); font-size: 0.9rem; line-height: 1.6; }
  .contact-section { border-top: 1px solid var(--line); background: var(--paper); }
  .contact-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(3rem, 8vw, 7rem); align-items: start; }
  .contact-grid form { display: grid; gap: 0.55rem; }
  .contact-grid label { margin-top: 0.65rem; font-size: 0.75rem; font-weight: 750; text-transform: uppercase; }
  .contact-grid button { justify-self: start; margin-top: 0.8rem; }
  .form-status { margin-top: 0.6rem; padding: 0.8rem; border: 1px solid var(--line); font-size: 0.85rem; }
  .form-status.success { border-color: #9ec9b8; background: #edf7f2; color: var(--green); }
  .form-status.error { border-color: #d7aaa5; background: #fff1ef; color: #8b2c23; }

  @media (max-width: 760px) {
    .team-header-grid,
    .contact-grid,
    .team-list article { grid-template-columns: 1fr; gap: 1.2rem; }
  }
</style>
