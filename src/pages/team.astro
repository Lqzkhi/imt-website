---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Team & Contact">
	<div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10 py-20">
		
		<div class="mb-24 border-b-2 border-slate-200 pb-20">
			<div class="text-center mb-12 max-w-3xl mx-auto">
				<h1 class="text-5xl font-extrabold text-slate-950 mb-6 tracking-tight">Meet the Organizers</h1>
				<p class="text-xl text-slate-600 leading-relaxed font-light">The Integrated Mathematics Tournament is student-led. We are passionate about expanding mathematical literacy and introducing like-minded peers to wider forms of mathematics.</p>
			</div>

			<div class="bg-white rounded-3xl shadow-card border border-gray-100 p-10 md:p-16 hover:shadow-card-hover hover:border-slate-300 transition duration-300 relative overflow-hidden">
                <div class="absolute top-0 right-0 -mt-16 -mr-16 w-64 h-64 bg-brand-gold opacity-10 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute bottom-0 left-0 -mb-16 -ml-16 w-64 h-64 bg-brand-green opacity-10 rounded-full blur-3xl pointer-events-none"></div>

                <div class="relative z-10 max-w-4xl mx-auto text-center">
                    <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-6">The Team</h2>
                    <p class="text-lg md:text-xl text-slate-600 leading-relaxed font-light mb-12">
                        IMT is organized fully by a committee of student mathematicians. 
                    </p>

                    <div class="grid sm:grid-cols-3 gap-6 text-left">
                        <div class="p-8 bg-slate-50 rounded-2xl border border-slate-100 hover:border-brand-green hover:shadow-md transition group">
                            <div class="text-brand-green font-extrabold text-xl mb-3 group-hover:scale-105 transform origin-left transition">USAMO & AIME</div>
                            <p class="text-slate-600 text-sm font-light leading-relaxed">Our committee is composed of Olympiad-level qualifiers (USAMO/USAJMO) and multi-time AIME qualifiers.</p>
                        </div>
                        
                        <div class="p-8 bg-slate-50 rounded-2xl border border-slate-100 hover:border-brand-gold hover:shadow-md transition group">
                            <div class="text-brand-gold font-extrabold text-xl mb-3 group-hover:scale-105 transform origin-left transition text-shadow-sm">AMC 10/12</div>
                            <p class="text-slate-600 text-sm font-light leading-relaxed">Including AMC 12 perfect scorers, and multiple DHR awardees.</p>
                        </div>
                        
                        <div class="p-8 bg-slate-50 rounded-2xl border border-slate-100 hover:border-brand-dark hover:shadow-md transition group">
                            <div class="text-brand-dark font-extrabold text-xl mb-3 group-hover:scale-105 transform origin-left transition">NC ARML Team</div>
                            <p class="text-slate-600 text-sm font-light leading-relaxed">Featuring active, high-performing members of the North Carolina state American Regions Mathematics League (ARML) team.</p>
                        </div>
                    </div>
                </div>
			</div>
		</div>

		<div class="bg-white rounded-3xl p-10 md:p-16 border-2 border-slate-100 flex flex-col md:flex-row gap-16 shadow-inner hover:border-slate-200 hover:shadow-lg transition duration-300">
			<div class="md:w-1/2 flex flex-col justify-center">
				<h2 class="text-4xl font-extrabold text-slate-950 mb-6 tracking-tight border-b-2 border-brand-green pb-4 inline-block">Reach Out</h2>
				<p class="text-slate-700 text-xl leading-relaxed mb-6 font-light">
					Reach out with any comments/concerns!
				</p>
			</div>
			
			<div class="md:w-1/2 bg-brand-light rounded-2xl shadow-xl p-10 border border-slate-100 hover:shadow-2xl hover:border-slate-300 transition duration-300 relative">
				<form id="contact-form" action="https://formspree.io/f/xojzalge" method="POST" class="space-y-8">
					<div>
						<label for="name" class="block text-sm font-semibold text-brand-dark mb-1.5">Full Name / Organization</label>
						<input type="text" name="name" id="name" required class="mt-1 block w-full rounded-lg border-slate-300 shadow-inner focus:border-brand-green focus:ring-brand-green p-3.5 border text-lg font-light placeholder:text-slate-400 outline-none transition" placeholder="Jane Doe / Company XYZ">
					</div>
					<div>
						<label for="email" class="block text-sm font-semibold text-brand-dark mb-1.5">Email Address</label>
						<input type="email" name="email" id="email" required class="mt-1 block w-full rounded-lg border-slate-300 shadow-inner focus:border-brand-green focus:ring-brand-green p-3.5 border text-lg font-light placeholder:text-slate-400 outline-none transition" placeholder="jane@example.com">
					</div>
					<div>
						<label for="message" class="block text-sm font-semibold text-brand-dark mb-1.5">Inquiry / Message</label>
						<textarea id="message" name="message" rows="4" required class="mt-1 block w-full rounded-lg border-slate-300 shadow-inner focus:border-brand-green focus:ring-brand-green p-3.5 border text-lg font-light placeholder:text-slate-400 outline-none transition resize-none" placeholder="We are interested in exploring partnership opportunities..."></textarea>
					</div>
					
                    <div id="contact-status" class="hidden font-bold text-center text-sm p-3 rounded-lg"></div>

                    <button id="contact-submit-btn" type="submit" class="w-full flex justify-center py-4 px-10 border-2 border-transparent rounded-lg shadow-lg text-lg font-bold text-brand-dark bg-brand-gold hover:opacity-90 transition transform duration-200 active:scale-95">
						Send Message
					</button>
				</form>
			</div>
		</div>

	</div>
</Layout>

<script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('contact-submit-btn');
    const statusDiv = document.getElementById('contact-status');

    if (form) {
        form.addEventListener('submit', async (e) => {
            e.preventDefault(); // Stop the default redirect
            
            submitBtn.textContent = "Sending...";
            submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
            statusDiv.classList.add('hidden');

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'Accept': 'application/json' }
                });

                if (response.ok) {
                    form.reset();
                    statusDiv.textContent = "Success! Your message has been sent.";
                    statusDiv.className = "font-bold text-center text-sm p-3 rounded-lg bg-green-50 text-brand-green mb-4";
                } else {
                    statusDiv.textContent = "Oops! There was a problem sending your message.";
                    statusDiv.className = "font-bold text-center text-sm p-3 rounded-lg bg-red-50 text-red-500 mb-4";
                }
            } catch (error) {
                statusDiv.textContent = "Network error. Please try again.";
                statusDiv.className = "font-bold text-center text-sm p-3 rounded-lg bg-red-50 text-red-500 mb-4";
            }

            submitBtn.textContent = "Send Message";
            submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        });
    }
</script>