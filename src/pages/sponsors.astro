---
import Layout from '../layouts/Layout.astro';

const sponsors = [
  {
    name: 'Art of Problem Solving',
    logo: '/aops-logo.svg',
    url:  'https://artofproblemsolving.com',
    desc: 'The gold standard in math resources for high-performing students — home of AMC prep, Alcumus, and a global community of mathematical thinkers.',
  },
  {
    name: 'Jane Street',
    logo: '/JANESTREET.png',
    url:  'https://janestreet.com',
    desc: 'A quantitative trading firm built on rigorous mathematical thinking, collaborative problem solving, and a deep respect for intellectual curiosity.',
  },
  {
    name: 'AwesomeMath',
    logo: '/AWESOMEMATH.png',
    url:  'https://awesomemath.org',
    desc: 'Exposing students to the creative and challenging side of mathematics through summer programs, publications, and Olympiad training.',
  },
  {
    name: 'Non-Trivial',
    logo: '/nontrivial.png',
    url:  'https://www.non-trivial.org',
    desc: 'A fellowship helping teenagers begin tackling the world\'s most pressing problems — bridging intellectual curiosity and real-world impact.',
  },
];
---

<Layout title="Sponsors">

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section class="bg-brand-dark text-brand-light pt-20 pb-24 border-b-4 border-brand-green relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.025]"
         style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 24px 24px;"
         aria-hidden="true"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 text-center animate-on-load">
      <span class="inline-block text-brand-green font-semibold tracking-widest uppercase text-xs mb-5">
        Our Partners
      </span>
      <h1 class="font-serif font-bold text-5xl md:text-6xl leading-[1.1] tracking-tight mb-5 max-w-3xl mx-auto">
        Organizations that believe<br />
        <em class="text-white/65 font-normal not-italic">math changes everything.</em>
      </h1>
      <p class="text-slate-300 text-lg max-w-xl mx-auto font-light leading-relaxed">
        IMT is supported by organizations that share our belief in rigorous, accessible, student-led mathematics.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       SPONSOR CARDS
  ══════════════════════════════════════════ -->
  <section class="py-20 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10">

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {sponsors.map((sponsor, i) => (
          <a href={sponsor.url} target="_blank" rel="noopener noreferrer"
             class={`group bg-white border border-gray-200 p-8 rounded-xl flex flex-col items-center text-center hover:border-brand-green hover:shadow-xl transition-all duration-300 hover:-translate-y-1.5 reveal-on-scroll delay-${i > 0 ? i * 100 : ''}`}>

            <!-- Logo -->
            <div class="h-20 w-full flex items-center justify-center mb-6">
              <img src={sponsor.logo} alt={sponsor.name}
                   class="max-h-full max-w-[140px] object-contain grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-300" />
            </div>

            <!-- Name + desc -->
            <h3 class="font-bold text-brand-dark text-base mb-2">{sponsor.name}</h3>
            <p class="text-slate-500 text-sm leading-relaxed flex-grow">{sponsor.desc}</p>

            <!-- Arrow link -->
            <span class="mt-5 text-brand-green font-bold text-xs flex items-center gap-1 group-hover:gap-2 transition-all duration-150 uppercase tracking-wider">
              Visit Website
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </span>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════
       BECOME A SPONSOR CTA
  ══════════════════════════════════════════ -->
  <section class="py-20 bg-brand-light">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10">
      <div class="reveal-on-scroll bg-white border border-gray-200 rounded-2xl p-12 md:p-16 flex flex-col md:flex-row items-start md:items-center justify-between gap-10 shadow-sm relative overflow-hidden">

        <div class="absolute top-0 right-0 p-6 opacity-[0.04] pointer-events-none" aria-hidden="true">
          <svg class="w-40 h-40 text-brand-dark" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
        </div>

        <div class="relative z-10 max-w-xl">
          <h2 class="font-serif font-bold text-3xl md:text-4xl text-brand-dark mb-3 leading-tight">
            Interested in sponsoring?
          </h2>
          <p class="text-slate-500 text-base leading-relaxed">
            Help us provide prizes, resources, and open-source learning materials to mathematical students around the world. Reach out to discuss partnership opportunities.
          </p>
        </div>

        <div class="relative z-10 shrink-0">
          <a href="/team"
             class="inline-block bg-brand-dark text-white font-bold px-10 py-4 rounded hover:bg-[#1e3152] transition-colors duration-150 btn-lift shadow-md">
            Get in Touch
          </a>
        </div>

      </div>
    </div>
  </section>

</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));
  });
</script>