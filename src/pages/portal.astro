---
import Layout from '../layouts/Layout.astro';

// Definitions for HTML generation based on IMT_Power.pdf
const sections = [
    { name: "Part I: A Tiny Brain With Four Neurons", problems: [1, 2, 3] },
    { name: "Part II: Memories as Attractors", problems: [4, 5] },
    { name: "Part III: Probability, Temperature, and Boltzmann Machines", problems: [6, 7] },
    { name: "Part IV: Spiking Neurons and Thresholds", problems: [8, 9] },
    { name: "Part V: Learning From Data", problems: [10, 11] },
    { name: "Optional Challenge: Memory Capacity", problems: [12] }
];
---

<Layout title="Tournament Portal">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" />
    <script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js"></script>

    <div id="global-loader" class="flex flex-col items-center justify-center min-h-[60vh]">
        <div class="animate-spin rounded-full h-16 w-16 border-t-4 border-b-4 border-brand-green mb-4"></div>
        <p class="text-slate-500 font-bold animate-pulse text-lg">Loading portal...</p>
    </div>

    <div class="max-w-[1500px] mx-auto px-4 sm:px-6 py-8 hidden animate-fade-in-up" id="auth-wrapper">
        
        <div id="portal-header" class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 border-b-2 border-slate-200 pb-6 gap-4">
            <div>
                <h1 class="text-3xl font-extrabold text-brand-dark" id="header-title">Tournament Portal</h1>
                <p class="text-brand-green font-bold text-sm mt-1" id="team-name-display">Loading Team...</p>
            </div>
            
            <div id="nav-actions" class="hidden flex items-center gap-4">
                <button id="open-pdf-btn" class="flex items-center gap-2 bg-brand-dark text-white font-bold px-5 py-2.5 rounded-lg shadow-md hover:bg-slate-800 transition disabled:opacity-50">
                    <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477-4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                    <span id="pdf-btn-text">Loading Packet...</span>
                </button>
                <button id="back-to-dash-btn" class="flex items-center gap-2 text-slate-500 font-bold hover:text-brand-dark transition bg-slate-100 hover:bg-slate-200 px-4 py-2.5 rounded-lg">
                    Exit Workspace
                </button>
            </div>
        </div>

        <div id="portal-dashboard" class="hidden">
            <h2 class="text-2xl font-bold text-slate-800 mb-6">Your Events</h2>
            
            <div class="bg-white rounded-3xl shadow-sm border border-slate-200 p-8 flex flex-col md:flex-row justify-between items-center gap-6 hover:shadow-md transition">
                <div class="w-full md:w-auto">
                    <div class="flex flex-wrap items-center gap-3 mb-3">
                        <h3 class="text-2xl font-extrabold text-brand-dark">Integrated Round</h3>
                        <span id="int-status-badge" class="bg-slate-100 text-slate-600 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">Checking...</span>
                    </div>
                    <p class="text-slate-600 text-sm mb-2 max-w-xl leading-relaxed">
                        An asynchronous applied modeling and proof-based round. You may open the workspace, research, and return as many times as you like.
                    </p>
                    <p class="text-brand-dark font-semibold text-sm bg-brand-gold/20 inline-block px-3 py-1 rounded-md">
                        Window: June 8th — June 12th at 11:59 PM EDT
                    </p>
                </div>
                
                <div class="w-full md:w-auto flex flex-col gap-3">
                    <button id="open-workspace-btn" class="w-full bg-brand-dark text-brand-gold font-bold px-8 py-4 rounded-xl hover:bg-slate-800 transition shadow-lg whitespace-nowrap">
                        Enter Workspace
                    </button>
                    <button id="view-grading-btn" class="hidden w-full bg-slate-50 border border-slate-200 text-slate-400 font-bold px-8 py-4 rounded-xl cursor-not-allowed whitespace-nowrap" disabled>
                        <span class="flex items-center justify-center gap-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                            View Grading (Locked)
                        </span>
                    </button>
                </div>
            </div>
        </div>

        <div id="int-workspace" class="hidden flex flex-col min-h-[700px]">
            
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 mb-6 flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-2 w-full md:w-auto">
                    <button id="prev-prob-btn" class="p-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition disabled:opacity-30 disabled:cursor-not-allowed">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    </button>
                    
                    <select id="problem-selector" class="flex-grow md:w-[400px] bg-slate-50 border border-slate-300 text-brand-dark font-bold text-sm rounded-lg focus:ring-brand-green focus:border-brand-green block p-2.5 outline-none">
                        {sections.map((sec) => (
                            <optgroup label={sec.name}>
                                {sec.problems.map((probNum) => (
                                    <option value={`${probNum}`}>Problem {probNum}</option>
                                ))}
                            </optgroup>
                        ))}
                    </select>

                    <button id="next-prob-btn" class="p-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition disabled:opacity-30 disabled:cursor-not-allowed">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </button>
                </div>

                <button type="button" id="submit-int-btn" class="w-full md:w-auto bg-brand-green text-white font-extrabold px-8 py-2.5 rounded-lg hover:bg-brand-green_dark transition shadow-md whitespace-nowrap flex items-center justify-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    Submit Integrated Round
                </button>
            </div>

            <form id="int-form" class="bg-white rounded-2xl shadow-lg border border-slate-200 p-6 flex-grow flex flex-col">
                <div class="flex justify-between items-start mb-6 border-b border-slate-100 pb-4">
                    <div>
                        <h3 class="text-2xl font-extrabold text-brand-dark" id="current-problem-title">Problem 1</h3>
                        <span class="text-xs font-bold text-slate-500 bg-brand-gold/20 px-3 py-1 rounded-full mt-2 inline-block">Due June 12</span>
                    </div>
                </div>

                {sections.map((sec) => (
                    sec.problems.map((probNum) => {
                        return (
                            <div id={`container-${probNum}`} class="problem-container hidden flex-col flex-grow">
                                
                                <div class="flex gap-2 p-1.5 bg-slate-100 rounded-xl w-full mb-6">
                                    <label class="flex-1 text-center cursor-pointer">
                                        <input type="radio" name={`mode_p${probNum}`} value="latex" class="mode-toggle peer hidden" data-prob={`${probNum}`} checked>
                                        <div class="py-3 rounded-lg font-bold text-sm text-slate-500 peer-checked:bg-white peer-checked:text-brand-dark peer-checked:shadow-sm transition">LaTeX (Recommended)</div>
                                    </label>
                                    <label class="flex-1 text-center cursor-pointer">
                                        <input type="radio" name={`mode_p${probNum}`} value="picture" class="mode-toggle peer hidden" data-prob={`${probNum}`}>
                                        <div class="py-3 rounded-lg font-bold text-sm text-slate-500 peer-checked:bg-white peer-checked:text-brand-dark peer-checked:shadow-sm transition">Picture / Scan Upload</div>
                                    </label>
                                </div>

                                <div class="flex-grow flex flex-col">
                                    
                                    <div id={`latex-mode-${probNum}`} class="grid md:grid-cols-2 gap-6 h-full min-h-[500px]">
                                        <div class="flex flex-col bg-slate-50 rounded-xl border border-slate-200 shadow-inner overflow-hidden h-full">
                                            <div class="p-3 border-b border-slate-200 flex justify-between items-center bg-slate-100">
                                                <span class="font-bold text-brand-dark text-sm">LaTeX Editor</span>
                                                <span id={`save-status-${probNum}`} class="text-xs text-slate-400 font-mono transition-colors duration-300"></span>
                                            </div>
                                            <textarea 
                                                name={`int_p${probNum}_text`} 
                                                class="auto-save-input flex-grow p-6 outline-none resize-none font-mono text-sm text-slate-800 bg-transparent focus:bg-white transition" 
                                                placeholder="Type your solution here...\n\nUse $ for inline math (e.g. $x^2 + y^2 = r^2$)\nUse $$ for block equations:\n\n$$ \n\\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a} \n$$"
                                            ></textarea>
                                        </div>

                                        <div class="flex flex-col bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden h-full">
                                            <div class="p-3 border-b border-slate-200 bg-brand-dark text-white">
                                                <span class="font-bold text-sm text-brand-gold">Live Preview</span>
                                            </div>
                                            <div class="latex-preview flex-grow p-8 overflow-y-auto text-slate-800 leading-relaxed text-base" style="white-space: pre-wrap;" id={`preview-${probNum}`}></div>
                                        </div>
                                    </div>

                                    <div id={`picture-mode-${probNum}`} class="hidden flex flex-col items-center justify-center min-h-[500px] bg-slate-50 border border-slate-200 rounded-xl p-8 upload-zone">
                                        <div class="bg-white p-10 rounded-2xl border-2 border-dashed border-slate-300 text-center max-w-2xl w-full hover:border-brand-green transition shadow-sm">
                                            <div class="w-16 h-16 bg-brand-green/10 text-brand-green rounded-full flex items-center justify-center mx-auto mb-4">
                                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                                            </div>
                                            <h4 class="text-xl font-bold text-brand-dark mb-2">Upload handwritten solution</h4>
                                            <p class="text-sm text-slate-500 mb-6">You may select and attach multiple files at once.<br/>(Supported: PDF, JPG, PNG)</p>
                                            
                                            <label class="cursor-pointer bg-brand-dark text-brand-gold font-bold px-8 py-3.5 rounded-lg hover:bg-slate-800 transition inline-block shadow-md">
                                                Select Files
                                                <input type="file" name={`int_p${probNum}_files`} accept=".pdf,image/*" multiple class="hidden file-input" data-prob={`${probNum}`} />
                                            </label>
                                            
                                            <div id={`file-display-${probNum}`} class="mt-8 w-full text-sm font-bold text-slate-700 bg-slate-50 border border-slate-100 p-4 rounded-xl text-left hidden max-h-48 overflow-y-auto shadow-inner"></div>
                                    
                                            <!-- NEW WARNING MESSAGE -->
                                            <p class="mt-6 text-xs text-red-500 font-bold bg-red-50 border border-red-100 p-3 rounded-lg text-center">
                                                ⚠️ Notice: Browsers automatically clear attached files if you reload/refresh the page. Please attach files right before submittting.
                                            </p>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        )
                    })
                ))}
            </form>
        </div>

        <div id="pdf-modal" class="hidden fixed inset-0 z-[100] bg-slate-900/80 backdrop-blur-sm flex items-center justify-center p-4 sm:p-8">
            <div class="bg-white w-full max-w-6xl h-full max-h-[90vh] rounded-2xl flex flex-col overflow-hidden shadow-2xl animate-fade-in-up">
                <div class="flex justify-between items-center p-4 border-b border-slate-200 bg-slate-50">
                    <h3 class="font-extrabold text-brand-dark text-lg">Integrated Packet (Read-Only)</h3>
                    <button id="close-pdf-btn" class="text-slate-500 hover:text-red-500 bg-white border border-slate-200 px-4 py-1.5 rounded-lg text-sm font-bold transition shadow-sm">Close Viewer</button>
                </div>
                <iframe id="secure-pdf-frame" src="" class="flex-grow w-full bg-slate-100"></iframe>
            </div>
        </div>

    </div>
</Layout>

<script>

    import { supabase } from '../lib/supabase.js';

    // UI Elements
    const globalLoader = document.getElementById('global-loader');
    const authWrapper = document.getElementById('auth-wrapper');
    const headerTitle = document.getElementById('header-title');
    const navActions = document.getElementById('nav-actions');
    const teamNameDisplay = document.getElementById('team-name-display');
    const currentProblemTitle = document.getElementById('current-problem-title');
    
    // Screens & Modals
    const dashboard = document.getElementById('portal-dashboard');
    const workspace = document.getElementById('int-workspace');
    const pdfModal = document.getElementById('pdf-modal');
    
    // Buttons & Inputs
    const statusBadge = document.getElementById('int-status-badge');
    const openWorkspaceBtn = document.getElementById('open-workspace-btn');
    const viewGradingBtn = document.getElementById('view-grading-btn');
    const backToDashBtn = document.getElementById('back-to-dash-btn');
    const submitIntBtn = document.getElementById('submit-int-btn');
    const openPdfBtn = document.getElementById('open-pdf-btn');
    const pdfBtnText = document.getElementById('pdf-btn-text');
    const closePdfBtn = document.getElementById('close-pdf-btn');
    
    // Navigation Controls
    const problemSelector = document.getElementById('problem-selector') as HTMLSelectElement;
    const prevProbBtn = document.getElementById('prev-prob-btn') as HTMLButtonElement;
    const nextProbBtn = document.getElementById('next-prob-btn') as HTMLButtonElement;

    const saveTimers = {};

    // --- SECURE PDF LOADER ---
    async function loadSecurePDF() {
        openPdfBtn.disabled = true;
        pdfBtnText.textContent = "Loading Packet...";

        const { data, error } = await supabase
            .storage
            .from('secure_materials')
            .createSignedUrl('IMT_Power.pdf', 7200);

        if (error) {
            console.error("Error loading PDF:", error.message);
            pdfBtnText.textContent = "Error Loading Packet";
        } else if (data) {
            document.getElementById('secure-pdf-frame').src = data.signedUrl;
            pdfBtnText.textContent = "View Packet";
            openPdfBtn.disabled = false;
        }
    }

    // --- PDF MODAL LOGIC ---
    openPdfBtn.addEventListener('click', () => pdfModal.classList.remove('hidden'));
    closePdfBtn.addEventListener('click', () => pdfModal.classList.add('hidden'));

    // --- NAVIGATION LOGIC ---
    function updateProblemView() {
        const selectedId = problemSelector.value;
        const selectedText = problemSelector.options[problemSelector.selectedIndex].text;
        
        document.querySelectorAll('.problem-container').forEach(el => el.classList.add('hidden'));
        document.getElementById(`container-${selectedId}`)?.classList.remove('hidden');
        
        if (currentProblemTitle) {
            currentProblemTitle.textContent = selectedText;
        }

        prevProbBtn.disabled = problemSelector.selectedIndex === 0;
        nextProbBtn.disabled = problemSelector.selectedIndex === problemSelector.options.length - 1;
    }

    problemSelector.addEventListener('change', updateProblemView);

    prevProbBtn.addEventListener('click', () => {
        if (problemSelector.selectedIndex > 0) {
            problemSelector.selectedIndex -= 1;
            updateProblemView();
        }
    });

    nextProbBtn.addEventListener('click', () => {
        if (problemSelector.selectedIndex < problemSelector.options.length - 1) {
            problemSelector.selectedIndex += 1;
            updateProblemView();
        }
    });

    // --- SUBMISSION MODE TOGGLE LOGIC ---
    document.querySelectorAll('.mode-toggle').forEach(radio => {
        radio.addEventListener('change', (e) => {
            const target = e.target as HTMLInputElement;
            const probNum = target.dataset.prob;
            const mode = target.value;
            
            const latexPanel = document.getElementById(`latex-mode-${probNum}`);
            const picturePanel = document.getElementById(`picture-mode-${probNum}`);
            
            if (mode === 'latex') {
                latexPanel.classList.remove('hidden');
                picturePanel.classList.add('hidden');
            } else {
                latexPanel.classList.add('hidden');
                picturePanel.classList.remove('hidden');
            }
        });
    });

    // --- FILE MANAGER LOGIC ---
    function updateFileDisplay(inputElement: HTMLInputElement) {
        const probNum = inputElement.dataset.prob;
        const displayContainer = document.getElementById(`file-display-${probNum}`);
        const files = inputElement.files;

        if (files && files.length > 0) {
            displayContainer.classList.remove('hidden');
            let html = `<span class="text-brand-dark mb-3 block border-b border-slate-200 pb-2">Attached Files (${files.length}):</span><div class="space-y-2">`;

            Array.from(files).forEach((file, index) => {
                html += `
                    <div class="flex justify-between items-center bg-white border border-slate-200 p-3 rounded-lg shadow-sm">
                        <span class="truncate max-w-[80%] text-slate-600 font-medium">${file.name}</span>
                        <button type="button" class="text-red-400 hover:text-red-600 hover:bg-red-50 p-1.5 rounded-md transition remove-file-btn" data-prob="${probNum}" data-index="${index}">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>
                `;
            });
            html += `</div>`;
            displayContainer.innerHTML = html;

            displayContainer.querySelectorAll('.remove-file-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const btnElement = e.currentTarget as HTMLElement;
                    const idxToRemove = parseInt(btnElement.dataset.index);
                    
                    const dt = new DataTransfer();
                    Array.from(inputElement.files).forEach((file, i) => {
                        if (i !== idxToRemove) dt.items.add(file);
                    });
                    
                    inputElement.files = dt.files;
                    updateFileDisplay(inputElement); 
                });
            });
        } else {
            displayContainer.classList.add('hidden');
            displayContainer.innerHTML = '';
        }
    }

    document.querySelectorAll('.file-input').forEach(input => {
        input.addEventListener('change', (e) => {
            updateFileDisplay(e.target as HTMLInputElement);
        });
    });

    // --- LATEX RENDERING LOGIC ---
    function renderLatex(textarea: HTMLTextAreaElement) {
        const probNum = textarea.name.split('_')[1].replace('p', '');
        const previewDiv = document.getElementById(`preview-${probNum}`);
        
        if (previewDiv) {
            previewDiv.textContent = textarea.value; 
            if (window.renderMathInElement) {
                window.renderMathInElement(previewDiv, {
                    delimiters: [
                        {left: '$$', right: '$$', display: true},
                        {left: '$', right: '$', display: false},
                        {left: '\\(', right: '\\)', display: false},
                        {left: '\\[', right: '\\]', display: true}
                    ],
                    throwOnError: false
                });
            }
        }
    }

    function loadDraft() {
        const savedData = JSON.parse(localStorage.getItem('imt_int_draft') || '{}');
        const inputs = document.querySelectorAll('.auto-save-input');
        let hasDraft = false;

        inputs.forEach((input: HTMLInputElement) => {
            if (savedData[input.name]) {
                input.value = savedData[input.name];
                hasDraft = true;
                
                const probNum = input.name.split('_')[1].replace('p', '');
                const statusSpan = document.getElementById(`save-status-${probNum}`);
                if (statusSpan && input.value.trim() !== '') {
                    statusSpan.textContent = "Draft loaded";
                    statusSpan.classList.add('text-brand-green');
                }
            }
            renderLatex(input);
        });
        return hasDraft;
    }

    window.addEventListener('load', () => {
        document.querySelectorAll('.auto-save-input').forEach((input: HTMLTextAreaElement) => renderLatex(input));
    });

    document.getElementById('int-form')?.addEventListener('input', (e) => {
        const target = e.target as HTMLTextAreaElement;
        
        if (target.classList.contains('auto-save-input')) {
            const probNum = target.name.split('_')[1].replace('p', '');
            
            const savedData = JSON.parse(localStorage.getItem('imt_int_draft') || '{}');
            savedData[target.name] = target.value;
            localStorage.setItem('imt_int_draft', JSON.stringify(savedData));
            
            renderLatex(target);

            const statusSpan = document.getElementById(`save-status-${probNum}`);
            if (statusSpan) {
                statusSpan.textContent = "Saving...";
                statusSpan.classList.remove('text-brand-green', 'text-slate-400');
                statusSpan.classList.add('text-brand-gold');

                clearTimeout(saveTimers[probNum]);
                saveTimers[probNum] = setTimeout(() => {
                    const now = new Date();
                    const timeString = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    statusSpan.textContent = `Saved at ${timeString}`;
                    statusSpan.classList.remove('text-brand-gold');
                    statusSpan.classList.add('text-brand-green');
                }, 800);
            }
        }
    });

    // --- ROUTING LOGIC ---
    function showDashboard(isDone, hasDraft) {
        workspace.classList.add('hidden');
        navActions.classList.add('hidden');
        dashboard.classList.remove('hidden');
        headerTitle.textContent = "Tournament Dashboard";

        if (isDone) {
            statusBadge.textContent = "Submitted ✅";
            statusBadge.classList.replace('bg-slate-100', 'bg-green-100');
            statusBadge.classList.replace('text-slate-600', 'text-green-700');
            
            openWorkspaceBtn.classList.add('hidden');
            viewGradingBtn.classList.remove('hidden');
        } else {
            openWorkspaceBtn.classList.remove('hidden');
            viewGradingBtn.classList.add('hidden');

            if (hasDraft) {
                statusBadge.textContent = "In Progress";
                statusBadge.classList.replace('bg-slate-100', 'bg-blue-100');
                statusBadge.classList.replace('text-slate-600', 'text-blue-700');
                openWorkspaceBtn.textContent = "Continue Round";
            } else {
                statusBadge.textContent = "Not Started";
                openWorkspaceBtn.textContent = "Enter Workspace";
            }
        }
    }

    function showWorkspace() {
        dashboard.classList.add('hidden');
        workspace.classList.remove('hidden');
        navActions.classList.remove('hidden');
        headerTitle.textContent = "Integrated Workspace";
        updateProblemView();
        loadDraft();
        loadSecurePDF(); // Only load the PDF URL if they actually enter the workspace
    }

    // --- INITIALIZATION (WITH DATABASE SECURITY CHECK) ---
    async function initPortal() {
        const { data: { user }, error: authError } = await supabase.auth.getUser();
        if (authError || !user) { window.location.href = '/register'; return; }

        teamNameDisplay.textContent = `Team: ${user.user_metadata?.team_name || user.email}`;

        const { data: dbSubmission } = await supabase
            .from('submissions')
            .select('id')
            .eq('user_id', user.id)
            .limit(1);

        const dbHasSubmitted = dbSubmission && dbSubmission.length > 0;
        
        if (dbHasSubmitted) {
            localStorage.setItem('imt_int_done', 'true');
        }

        const isIntDone = dbHasSubmitted || localStorage.getItem('imt_int_done') === 'true';
        const hasDraft = Object.keys(JSON.parse(localStorage.getItem('imt_int_draft') || '{}')).length > 0;

        showDashboard(isIntDone, hasDraft);

        // Hide loading screen, show portal wrapper
        if (globalLoader) globalLoader.classList.add('hidden');
        if (authWrapper) authWrapper.classList.remove('hidden');
    }

    openWorkspaceBtn.addEventListener('click', showWorkspace);

    backToDashBtn.addEventListener('click', () => {
        const hasDraft = Object.keys(JSON.parse(localStorage.getItem('imt_int_draft') || '{}')).length > 0;
        showDashboard(false, hasDraft);
    });

    submitIntBtn.addEventListener('click', async () => {
        if(confirm("Submit Integrated Round? You cannot undo this. Ensure all solutions are attached before clicking OK.")) {
            await processIntSubmission();
        }
    });

    async function processIntSubmission() {
        const originalText = submitIntBtn.innerHTML;
        submitIntBtn.innerHTML = "Uploading... Please wait.";
        submitIntBtn.classList.add('opacity-50', 'cursor-not-allowed');
        submitIntBtn.disabled = true;

        try {
            const { data: { user } } = await supabase.auth.getUser();
            const form = document.getElementById('int-form') as HTMLFormElement;
            const formData = new FormData(form);
            const textAnswers = {}; const filePaths = {};

            const safeEmailFolder = (user.email || "Unknown_User").replace(/[^a-zA-Z0-9]/g, '_');

            for (let i = 1; i <= 12; i++) {
                const mode = formData.get(`mode_p${i}`);
                
                if (mode === 'latex') {
                    const textValue = formData.get(`int_p${i}_text`);
                    if (textValue && typeof textValue === 'string' && textValue.trim() !== '') {
                        textAnswers[`p${i}`] = textValue.trim();
                    }
                } else if (mode === 'picture') {
                    const files = formData.getAll(`int_p${i}_files`);
                    if (files && files.length > 0) {
                        filePaths[`p${i}`] = [];
                        for (let j = 0; j < files.length; j++) {
                            const fileValue = files[j];
                            if (fileValue instanceof File && fileValue.size > 0) {
                                const ext = fileValue.name.split('.').pop();
                                
                                const filePath = `${safeEmailFolder}/Problem_${i}_File_${j + 1}_${Date.now()}.${ext}`;
                                
                                const { data, error } = await supabase.storage.from('pdf_uploads').upload(filePath, fileValue);
                                if (error) throw error;
                                filePaths[`p${i}`].push(data.path); 
                            }
                        }
                    }
                }
            }

            const { error } = await supabase.from('submissions').insert({
                user_id: user.id,
                team_name: user.user_metadata?.team_name || user.email,
                text_answers: { round: "Integrated", ...textAnswers },
                pdf_paths: filePaths
            });
            if (error) throw error;

            localStorage.setItem('imt_int_done', 'true');
            localStorage.removeItem('imt_int_draft'); 
            
            showDashboard(true, false);
            alert("Success! Your team's Integrated Round has been submitted. You can now safely close this window.");

        } catch (err) {
            alert("Error: " + err.message);
            submitIntBtn.innerHTML = originalText;
            submitIntBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            submitIntBtn.disabled = false;
        }
    }

    const style = document.createElement('style');
    style.innerHTML = `
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fade-in-up { animation: fadeInUp 0.3s ease-out forwards; }
    `;
    document.head.appendChild(style);

    initPortal();
</script>