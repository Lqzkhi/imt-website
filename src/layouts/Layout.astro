---
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Free online math competitions and resources in proof, modeling, and higher mathematics.',
} = Astro.props;

const fallRegistrationUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSdp3uVAAHhcEO5q9WzS2fkNh0fypudgwIUSuC_87fjJBcKVug/viewform?usp=publish-editor';
const path = Astro.url.pathname;
const navItems = [
  { href: '/competitions', label: 'Competitions' },
  { href: '/learn', label: 'Learn' },
  { href: '/sponsors', label: 'Sponsors' },
  { href: '/team', label: 'About' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="icon" type="image/png" href="/bridge-icon-offwhite.png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Integrated Math</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="D9QIVtP_MgreLoXxoRklkcyIU3o-eUYsJkiqSdJh9A0" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={`${title} | Integrated Math`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.integratedmath.org/social-preview.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>

  <body class="min-h-screen bg-brand-light text-brand-dark antialiased">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="announcement">
      <div class="site-container announcement-inner">
        <span><strong>Fall 2026:</strong> Round 1, Sep 26–Oct 10. Live final, Oct 17.</span>
        <a href={fallRegistrationUrl} target="_blank" rel="noopener noreferrer">Registration is open</a>
      </div>
    </div>

    <header class="site-header">
      <div class="site-container header-inner">
        <a href="/" class="wordmark" aria-label="Integrated Math home">
          <img src="/bridge-icon.png" alt="" aria-hidden="true" />
          <span>Integrated Math</span>
        </a>

        <nav class="desktop-nav" aria-label="Primary navigation">
          {navItems.map(item => (
            <a
              href={item.href}
              aria-current={path.startsWith(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          <a class="register-link" href="/register">Register</a>
        </nav>

        <button id="mobile-menu-btn" class="menu-button" type="button" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>

      <nav id="mobile-menu" class="mobile-nav" aria-label="Mobile navigation" hidden>
        <div class="site-container">
          {navItems.map(item => <a href={item.href}>{item.label}</a>)}
          <a href="/register">Register</a>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-container footer-main">
        <div>
          <a href="/" class="footer-wordmark">Integrated Math</a>
          <p>Student-led. Globally minded. Bridging theory and application.</p>
        </div>
        <div class="footer-links">
          <a href="/competitions">Competitions</a>
          <a href="/learn">Learn</a>
          <a href="/sponsors">Sponsors</a>
          <a href="/team">Team &amp; contact</a>
        </div>
      </div>
      <div class="site-container footer-bottom">
        <span>&copy; {new Date().getFullYear()} Integrated Mathematics</span>
        <a href="/register">Email updates</a>
      </div>
    </footer>

    <Analytics />
  </body>
</html>

<script>
  const menuButton = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function closeMenu() {
    if (!mobileMenu || !menuButton) return;
    mobileMenu.hidden = true;
    menuButton.setAttribute('aria-expanded', 'false');
    menuButton.setAttribute('aria-label', 'Open menu');
  }

  menuButton?.addEventListener('click', () => {
    if (!mobileMenu) return;
    const willOpen = mobileMenu.hidden;
    mobileMenu.hidden = !willOpen;
    menuButton.setAttribute('aria-expanded', String(willOpen));
    menuButton.setAttribute('aria-label', willOpen ? 'Close menu' : 'Open menu');
  });

  mobileMenu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') closeMenu();
  });
</script>

<style is:global>
  .skip-link {
    position: fixed;
    left: 1rem;
    top: 1rem;
    z-index: 200;
    padding: 0.75rem 1rem;
    background: white;
    color: var(--ink);
    transform: translateY(-160%);
  }

  .skip-link:focus { transform: translateY(0); }

  .announcement {
    background: var(--green);
    color: white;
    font-size: 0.78rem;
  }

  .announcement-inner {
    min-height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem 1.25rem;
    text-align: center;
  }

  .announcement a {
    color: white;
    font-weight: 750;
    white-space: nowrap;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: rgba(244, 241, 232, 0.97);
  }

  .header-inner {
    display: flex;
    min-height: 4.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
    font-family: "Inter", Arial, sans-serif;
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .wordmark img { width: auto; height: 1.65rem; }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.7rem;
  }

  .desktop-nav a {
    color: #4f5b6d;
    font-size: 0.84rem;
    font-weight: 650;
    text-decoration: none;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] { color: var(--green); }

  .desktop-nav .register-link {
    border-left: 1px solid var(--line);
    padding: 0.55rem 0 0.55rem 1.7rem;
    color: var(--ink);
  }

  .menu-button {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: transparent;
    padding: 0.7rem;
  }

  .menu-button span {
    display: block;
    height: 1px;
    margin: 0.32rem 0;
    background: var(--ink);
  }

  .mobile-nav {
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .mobile-nav[hidden] { display: none; }
  .mobile-nav div { padding-block: 0.6rem 1rem; }
  .mobile-nav a {
    display: block;
    border-bottom: 1px solid var(--soft-line);
    padding: 0.85rem 0;
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 650;
    text-decoration: none;
  }

  .site-footer {
    border-top: 1px solid #2d3934;
    background: var(--ink);
    color: #c9d0cc;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3rem;
    padding-block: 3.5rem 2.5rem;
  }

  .footer-wordmark {
    color: white;
    font-family: "Inter", Arial, sans-serif;
    font-size: 1.35rem;
    font-weight: 650;
    text-decoration: none;
  }

  .footer-main p {
    max-width: 430px;
    margin: 0.8rem 0 0;
    color: #9aa4b3;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, auto);
    align-content: start;
    gap: 0.7rem 2rem;
  }

  .footer-links a,
  .footer-bottom a {
    color: #c9d0cc;
    font-size: 0.82rem;
    text-decoration: none;
  }

  .footer-links a:hover,
  .footer-bottom a:hover { color: white; text-decoration: underline; }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid #303b36;
    padding-block: 1rem;
    color: #7f8a85;
    font-size: 0.75rem;
  }

  @media (max-width: 820px) {
    .desktop-nav { display: none; }
    .menu-button { display: block; }
    .footer-main { grid-template-columns: 1fr; }
  }

  @media (max-width: 620px) {
    .announcement-inner { justify-content: space-between; text-align: left; }
    .announcement-inner strong { display: block; }
    .footer-links { grid-template-columns: 1fr; }
    .footer-bottom { align-items: flex-start; flex-direction: column; }
  }
</style>
