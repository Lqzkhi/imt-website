---
import Analytics from '@vercel/analytics/astro';

export interface Props {
	title: string;
	description?: string;
}

const { 
    title,
    description = "The Integrated Mathematics Tournament (IMT) is an annual online math competition for middle and high school students focusing on applied mathematics and problem-solving."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} | Integrated Mathematics Tournament</title>
		
        <meta name="description" content={description} />
        
        <meta name="google-site-verification" content="D9QIVtP_MgreLoXxoRklkcyIU3o-eUYsJkiqSdJh9A0" />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={`${title} | Integrated Mathematics Tournament`} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content="https://www.integratedmathtournament.org/social-preview.png" />
		
        <script is:inline>
            if (localStorage.getItem('imt_auth') === 'true') {
                document.documentElement.classList.add('is-authenticated');
            }
        </script>

        <link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
		<script is:inline src="https://cdn.tailwindcss.com"></script>
		<script is:inline>
			tailwind.config = {
				theme: {
					extend: {
						colors: {
							brand: {
								dark: '#2B2D42',
								gold: '#fcd34d',
								light: '#F6F0ED',
								green: '#4A7C59',
							}
						},
						fontFamily: {
							inter: ['Inter', 'sans-serif'],
						}
					}
				}
			}
		</script>
		<style is:global>
			html { font-family: 'Inter', sans-serif; }
			body { @apply flex flex-col min-h-screen bg-brand-light text-brand-dark; }
			main { @apply flex-grow; }
            
            /* Instant CSS swapping based on the script above */
            #nav-logged-out { display: flex; }
            #nav-logged-in { display: none; }
            #mobile-nav-logged-out { display: block; }
            #mobile-nav-logged-in { display: none; }
            
            html.is-authenticated #nav-logged-out { display: none !important; }
            html.is-authenticated #nav-logged-in { display: flex !important; }
            html.is-authenticated #mobile-nav-logged-out { display: none !important; }
            html.is-authenticated #mobile-nav-logged-in { display: block !important; }
		</style>
	</head>
	<body>
		<header class="bg-brand-light shadow-sm border-b border-gray-100 sticky top-0 z-50 relative">
			<div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10">
				<div class="flex justify-between items-center h-20">
					<div class="flex-shrink-0 flex items-center">
                        <a href="/" class="text-3xl font-extrabold text-brand-dark tracking-tighter">IMT</a>
					</div>
					
                    <!-- Desktop Nav -->
					<nav class="hidden md:flex items-center space-x-8">
                        <a href="/" class="text-brand-dark hover:text-brand-gold font-semibold transition duration-200">Home</a>
    					<a href="/format" class="text-brand-dark hover:text-brand-gold font-semibold transition duration-200">Format</a>
    					<a href="/sponsors" class="text-brand-dark hover:text-brand-gold font-semibold transition duration-200">Sponsors</a>
						<a href="/practice" class="text-brand-dark hover:text-brand-gold font-semibold transition duration-200">Practice</a>
                        <a href="/team" class="text-brand-dark hover:text-brand-gold font-semibold transition duration-200">Team & Contact</a>
						
						<div class="flex items-center border-l-2 border-slate-200 pl-6 ml-2 min-h-[40px]">
                            <div id="nav-logged-out" class="items-center space-x-4">
                                <a href="/register" class="bg-brand-dark text-brand-gold px-5 py-2 rounded-full hover:bg-slate-800 transition shadow-md text-sm font-bold">
                                    Register
                                </a>
                            </div>

                            <div id="nav-logged-in" class="items-center space-x-4">
                                <a href="/portal" class="font-bold text-brand-green hover:text-brand-dark transition">Portal</a>
                                <a href="/account" class="font-bold text-slate-600 hover:text-brand-dark transition">My Account</a>
                                <button id="nav-logout-btn" class="font-bold text-red-500 hover:text-red-700 transition text-sm px-3 py-1 bg-red-50 rounded-full">
                                    Sign Out
                                </button>
                            </div>
                        </div>
					</nav>

                    <!-- Mobile Menu Button -->
                    <div class="md:hidden flex items-center">
                        <button id="mobile-menu-btn" class="text-brand-dark focus:outline-none p-2">
                            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                        </button>
                    </div>
				</div>
			</div>

            <!-- Mobile Dropdown Menu -->
            <div id="mobile-menu" class="hidden md:hidden absolute top-20 left-0 w-full bg-brand-light border-b border-gray-200 shadow-xl px-6 py-6 space-y-4 z-40">
                <a href="/" class="block text-brand-dark text-lg font-semibold">Home</a>
                <a href="/format" class="block text-brand-dark text-lg font-semibold">Format</a>
                <a href="/sponsors" class="block text-brand-dark text-lg font-semibold">Sponsors</a>
                <a href="/practice" class="block text-brand-dark text-lg font-semibold">Practice</a>
                <a href="/team" class="block text-brand-dark text-lg font-semibold">Team & Contact</a>
                
                <hr class="border-gray-200 my-4">
                
                <div id="mobile-nav-logged-out" class="space-y-4">
                    <a href="/register" class="block text-center bg-brand-dark text-brand-gold px-5 py-3 rounded-xl font-bold">Register</a>
                </div>

                <div id="mobile-nav-logged-in" class="space-y-4">
                    <a href="/portal" class="block text-brand-green text-lg font-bold">Portal</a>
                    <a href="/account" class="block text-slate-600 text-lg font-bold">My Account</a>
                    <button id="mobile-logout-btn" class="block text-left text-red-500 text-lg font-bold">Sign Out</button>
                </div>
            </div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="bg-brand-dark text-brand-light mt-16 border-t-4 border-brand-green">
			<div class="max-w-7xl mx-auto py-16 px-6 sm:px-8 lg:px-10">
				<div class="text-center md:text-left">
					<span class="text-3xl font-extrabold tracking-tighter text-brand-gold">Integrated Mathematics Tournament</span>
				</div>
			</div>
		</footer>

        <Analytics />
	</body>
</html>

<script>
    import { supabase } from '../lib/supabase.js';

    // Desktop auth state
    supabase.auth.onAuthStateChange((event, session) => {
        if (session) {
            localStorage.setItem('imt_auth', 'true');
            document.documentElement.classList.add('is-authenticated');
        } else {
            localStorage.removeItem('imt_auth');
            document.documentElement.classList.remove('is-authenticated');
        }
    });

    // Logout handling for both desktop and mobile
    const logoutBtn = document.getElementById('nav-logout-btn');
    const mobileLogoutBtn = document.getElementById('mobile-logout-btn');
    
    const handleLogout = async () => {
        await supabase.auth.signOut();
        window.location.href = '/'; 
    };

    if (logoutBtn) logoutBtn.addEventListener('click', handleLogout);
    if (mobileLogoutBtn) mobileLogoutBtn.addEventListener('click', handleLogout);

    // Mobile menu toggle logic
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileMenuBtn && mobileMenu) {
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });
    }
</script>